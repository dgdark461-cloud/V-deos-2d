 "segments": [
  {
   "i": 0,
   "text": "Sua mãe sempre avisou pra não aceitar nada de estranhos...",
   "start": 0.0,
   "end": 2.92,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "mas você aceitou aquele brisadeiro achando que era só um doce inocente,",
   "start": 3.23,
   "end": 6.81,
   "anchored_on_pause": false
  },
  {
   "i": 2,
   "text": "e agora não consegue parar de rir.",
   "start": 6.81,
   "end": 8.46,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "Esse pesadelo atingiu Lucas quando a risada começou a subir pelo peito no silêncio absoluto da madrugada.",
   "start": 8.7,
   "end": 14.13,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "O primeiro impulso dele foi tentar controlar o maxilar,",
   "start": 14.64,
   "end": 17.28,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "fechar a boca e fingir que estava tudo sob controle.",
   "start": 17.49,
   "end": 19.87,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "Erro fatal.",
   "start": 20.39,
   "end": 20.96,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "Ao tentar rir disfarçado no escuro...",
   "start": 21.24,
   "end": 23.19,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Lucas percebeu que a sua própria imagem no espelho continuava gargalhando muito tempo depois de ele ter parado de emitir qualquer som.",
   "start": 23.61,
   "end": 29.91,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Para sair vivo dessa pira sem enlouquecer...",
   "start": 30.35,
   "end": 32.47,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "existe um protocolo de sobrevivência rigoroso que ele precisa seguir à risca.",
   "start": 32.9,
   "end": 36.4,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Primeira regra:",
   "start": 36.52,
   "end": 37.67,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "se a onda começar a puxar forte demais e os objetos ao redor no quarto começarem a respirar...",
   "start": 38.15,
   "end": 43.18,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "feche os olhos imediatamente.",
   "start": 43.71,
   "end": 45.1,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "Não faça nenhum tipo de barulho,",
   "start": 45.24,
   "end": 46.927,
   "anchored_on_pause": false
  },
  {
   "i": 15,
   "text": "não tente lutar contra o peso do corpo e deite-se de bruços no chão frio para tentar firmar a gravidade.",
   "start": 46.927,
   "end": 52.06,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Segunda regra:",
   "start": 52.29,
   "end": 52.76,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "nunca olhe diretamente para o canto escuro do teto,",
   "start": 53.37,
   "end": 55.967,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "por mais que sinta que há algo pendurado ali.",
   "start": 55.967,
   "end": 58.24,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Fazer isso atrai a atenção direta daquilo que só se aproxima de quem perdeu completamente o controle da própria mente.",
   "start": 58.55,
   "end": 64.58,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "Terceira regra:",
   "start": 64.73,
   "end": 65.37,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "se você ouvir o som nítido de passos arrastados vindo da direção da cozinha...",
   "start": 65.74,
   "end": 70.0,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "pegue o celular no bolso,",
   "start": 70.42,
   "end": 71.487,
   "anchored_on_pause": false
  },
  {
   "i": 23,
   "text": "mas jamais tente usar a luz da tela para clarear o escuro da sala,",
   "start": 71.487,
   "end": 74.79,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "pois a luminosidade atrai o que quer que esteja te observando.",
   "start": 75.3,
   "end": 78.12,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Com o coração disparado e o suor frio escorrendo pela testa...",
   "start": 78.41,
   "end": 81.24,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "Lucas ficou completamente imóvel no meio do quarto escuro.",
   "start": 81.87,
   "end": 84.66,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "Ele segurava a respiração a cada segundo,",
   "start": 84.92,
   "end": 86.82,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "tentando se ancorar na realidade,",
   "start": 86.98,
   "end": 88.58,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "mas o som ritmado do relógio de parede parecia desacelerar a cada batida,",
   "start": 89.0,
   "end": 93.25,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "transformando cada tique-taque em um estrondo arrastado e distante.",
   "start": 93.61,
   "end": 97.04,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Foi então que uma voz grave,",
   "start": 97.24,
   "end": 98.77,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "distorcida e extremamente sussurrada ecoou bem perto do seu ouvido,",
   "start": 98.91,
   "end": 103.73,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "parecendo vir simultaneamente do corredor e de dentro da sua própria cabeça:",
   "start": 103.89,
   "end": 107.695,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "\"Eu avisei para não comer o doce todo de uma vez...\"",
   "start": 107.695,
   "end": 110.595,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "Lucas tentou fechar os olhos e respirar fundo...",
   "start": 110.595,
   "end": 113.03,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "torcendo com todas as forças para que aquilo fosse apenas a sua percepção pregando peças e que o efeito do doce finalmente passasse.",
   "start": 113.17,
   "end": 119.19,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Mas foi exatamente nesse momento que ele sentiu um arrepio congelante subir por toda a nuca...",
   "start": 119.33,
   "end": 124.22,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "e percebeu a verdade aterrorizante:",
   "start": 124.45,
   "end": 126.556,
   "anchored_on_pause": false
  },
  {
   "i": 39,
   "text": "o brisadeiro não era apenas um pedaço de chocolate.",
   "start": 126.556,
   "end": 129.977,
   "anchored_on_pause": false
  },
  {
   "i": 40,
   "text": "Ele tinha sido a senha perfeita para abrir as portas da sua mente...",
   "start": 129.977,
   "end": 133.99,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "e deixar o monstro entrar.",
   "start": 134.14,
   "end": 135.85,
   "anchored_on_pause": null
  }
 ],
