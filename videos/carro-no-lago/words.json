 "segments": [
  {
   "i": 0,
   "text": "E se você perdesse o controle do carro em uma curva no escuro,",
   "start": 0.0,
   "end": 3.011,
   "anchored_on_pause": false
  },
  {
   "i": 1,
   "text": "despencasse de um penhasco e abrisse os olhos afundando no breu de um lago congelante?",
   "start": 3.011,
   "end": 7.18,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Com a água escura subindo rapidamente pelos seus pés e a porta travada,",
   "start": 7.3,
   "end": 11.27,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "não entre em pânico:",
   "start": 11.41,
   "end": 12.91,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "tentar forçá-la agora é inútil,",
   "start": 13.05,
   "end": 14.626,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "pois a pressão da água do lado de fora prende você como uma prensa de aço.",
   "start": 14.626,
   "end": 16.54,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "Foi exatamente essa armadilha mortal que atingiu Alex após o impacto do acidente,",
   "start": 16.68,
   "end": 22.56,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "quando ele despertou tonto no banco do motorista,",
   "start": 22.72,
   "end": 24.48,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "vendo o carro afundar no meio da madrugada.",
   "start": 24.62,
   "end": 26.561,
   "anchored_on_pause": false
  },
  {
   "i": 9,
   "text": "Com a água já na altura do peito e o painel elétrico soltando faíscas antes de pifar,",
   "start": 26.561,
   "end": 31.08,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "o primeiro instinto é esmurrar os vidros e gritar por socorro.",
   "start": 31.24,
   "end": 33.897,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "Erro fatal.",
   "start": 33.897,
   "end": 34.463,
   "anchored_on_pause": false
  },
  {
   "i": 12,
   "text": "O desespero faz você gastar o dobro do oxigênio e a água abafará completamente qualquer som na superfície.",
   "start": 34.463,
   "end": 40.9,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "Para sair vivo dessa tumba líquida,",
   "start": 41.06,
   "end": 42.562,
   "anchored_on_pause": false
  },
  {
   "i": 14,
   "text": "existe um protocolo de sobrevivência implacável.",
   "start": 42.562,
   "end": 45.19,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Primeira regra:",
   "start": 45.33,
   "end": 45.93,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "esqueça as portas e foque nos vidros laterais antes que a água cubra o teto.",
   "start": 46.08,
   "end": 49.211,
   "anchored_on_pause": false
  },
  {
   "i": 17,
   "text": "Segunda regra:",
   "start": 49.211,
   "end": 49.87,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "se os vidros elétricos pifarem,",
   "start": 49.87,
   "end": 51.236,
   "anchored_on_pause": false
  },
  {
   "i": 19,
   "text": "não tente quebrar o para-brisa,",
   "start": 51.236,
   "end": 52.601,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "pois ele é feito de vidro laminado ultrarresistente;",
   "start": 52.601,
   "end": 55.59,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "use as hastes de ferro do encosto de cabeça para alavancar e estilhaçar a janela lateral.",
   "start": 55.75,
   "end": 62.15,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "Terceira regra:",
   "start": 62.28,
   "end": 62.88,
   "anchored_on_pause": false
  },
  {
   "i": 23,
   "text": "se a água já cobriu tudo,",
   "start": 62.88,
   "end": 63.908,
   "anchored_on_pause": false
  },
  {
   "i": 24,
   "text": "você terá que esperar a cabine lotar completamente para igualar a pressão interna e externa só então a porta abrirá.",
   "start": 63.908,
   "end": 69.32,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Com a água já atingindo o seu queixo e o frio congelando seus músculos,",
   "start": 69.47,
   "end": 72.037,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "Alex consegue arrancar o encosto do banco no último segundo.",
   "start": 72.037,
   "end": 74.396,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "O ar acaba.",
   "start": 74.396,
   "end": 74.981,
   "anchored_on_pause": false
  },
  {
   "i": 28,
   "text": "O carro toca o fundo do lago levantando lama.",
   "start": 74.981,
   "end": 76.71,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "No breu absoluto,",
   "start": 76.86,
   "end": 77.547,
   "anchored_on_pause": false
  },
  {
   "i": 30,
   "text": "ele finca o metal no canto do vidro,",
   "start": 77.547,
   "end": 78.963,
   "anchored_on_pause": false
  },
  {
   "i": 31,
   "text": "que se estilhaça com um estrondo abafado.",
   "start": 78.963,
   "end": 80.588,
   "anchored_on_pause": false
  },
  {
   "i": 32,
   "text": "A água invade com violência,",
   "start": 80.588,
   "end": 81.692,
   "anchored_on_pause": false
  },
  {
   "i": 33,
   "text": "empurrando-o para trás.",
   "start": 81.692,
   "end": 82.587,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "Lutando contra a correnteza e sem enxergar nada,",
   "start": 82.587,
   "end": 84.87,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "ele nada desesperadamente em direção à luz fraca da lua na superfície.",
   "start": 85.0,
   "end": 87.724,
   "anchored_on_pause": false
  },
  {
   "i": 36,
   "text": "Alex emerge à tona,",
   "start": 87.724,
   "end": 88.572,
   "anchored_on_pause": false
  },
  {
   "i": 37,
   "text": "tossindo e sugando o ar nos pulmões,",
   "start": 88.572,
   "end": 89.915,
   "anchored_on_pause": false
  },
  {
   "i": 38,
   "text": "apenas para perceber com horror que nadou para debaixo de uma espessa camada de gelo,",
   "start": 89.915,
   "end": 93.033,
   "anchored_on_pause": false
  },
  {
   "i": 39,
   "text": "ficando preso do lado de fora do carro,",
   "start": 93.033,
   "end": 94.474,
   "anchored_on_pause": false
  },
  {
   "i": 40,
   "text": "mas ainda sem conseguir respirar.",
   "start": 94.474,
   "end": 95.52,
   "anchored_on_pause": null
  }
 ],
