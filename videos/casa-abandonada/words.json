": 121.06}, {"start": 122.88, "end": 123.05}, {"start": 125.86, "end": 126.32}, {"start": 130.53, "end": 130.66}, {"start": 133.12, "end": 133.32}, {"start": 134.0, "end": 134.12}, {"start": 134.31, "end": 134.68}, {"start": 136.22, "end": 136.41}, {"start": 137.48, "end": 137.67}, {"start": 139.01, "end": 139.24}, {"start": 141.07, "end": 141.21}, {"start": 142.24, "end": 142.36}, {"start": 143.48, "end": 143.61}, {"start": 147.59, "end": 147.83}, {"start": 148.13, "end": 148.3}, {"start": 150.05, "end": 150.41}], "segments": [{"i": 0, "text": "Você aceitaria 1 milhão de dólares pra passar uma noite em uma casa abandonada?", "start": 0, "end": 4.63, "anchored_on_pause": true}, {"i": 1, "text": "Foi exatamente essa proposta que Gabriel recebeu depois de se inscrever em um desafio na internet.", "start": 4.96, "end": 10.11, "anchored_on_pause": true}, {"i": 2, "text": "Ele estava desempregado,", "start": 10.25, "end": 11.66, "anchored_on_pause": false}, {"i": 3, "text": "cheio de dívidas e não pensou duas vezes antes de aceitar.", "start": 11.66, "end": 14.587, "anchored_on_pause": false}, {"i": 4, "text": "Mas havia uma condição:", "start": 14.587, "end": 16.01, "anchored_on_pause": true}, {"i": 5, "text": "precisava entrar na casa às 22 horas,", "start": 16.37, "end": 18.69, "anchored_on_pause": true}, {"i": 6, "text": "permanecer lá até as 6 da manhã e seguir três regras.", "start": 18.91, "end": 21.84, "anchored_on_pause": true}, {"i": 7, "text": "A primeira era não sair por nenhum motivo.", "start": 22.01, "end": 24.22, "anchored_on_pause": true}, {"i": 8, "text": "A segunda era não abrir a porta do porão.", "start": 24.52, "end": 26.41, "anchored_on_pause": true}, {"i": 9, "text": "E a terceira era nunca responder se alguém chamasse seu nome durante a madrugada.", "start": 26.53, "end": 30.63, "anchored_on_pause": true}, {"i": 10, "text": "Gabriel achou as regras exageradas,", "start": 30.81, "end": 32.543, "anchored_on_pause": false}, {"i": 11, "text": "mas,", "start": 32.543, "end": 32.77, "anchored_on_pause": true}, {"i": 12, "text": "por um milhão de dólares,", "start": 32.91, "end": 34.48, "anchored_on_pause": true}, {"i": 13, "text": "não estava disposto a desistir.", "start": 34.65, "end": 35.92, "anchored_on_pause": true}, {"i": 14, "text": "Quando chegou,", "start": 36.11, "end": 36.61, "anchored_on_pause": true}, {"i": 15, "text": "encontrou uma construção enorme,", "start": 36.75, "end": 38.35, "anchored_on_pause": true}, {"i": 16, "text": "cercada por árvores,", "start": 38.47, "end": 39.66, "anchored_on_pause": true}, {"i": 17, "text": "com janelas quebradas,", "start": 39.83, "end": 40.99, "anchored_on_pause": true}, {"i": 18, "text": "paredes descascadas e móveis cobertos por lençóis.", "start": 41.11, "end": 44.07, "anchored_on_pause": true}, {"i": 19, "text": "Havia câmeras espalhadas pelos cômodos e um envelope sobre a mesa com a promessa de pagamento.", "start": 44.56, "end": 48.02, "anchored_on_pause": true}, {"i": 20, "text": "Antes de ir embora,", "start": 48.14, "end": 49.22, "anchored_on_pause": true}, {"i": 21, "text": "o organizador entregou uma última coisa:", "start": 49.39, "end": 52.0, "anchored_on_pause": true}, {"i": 22, "text": "um rádio comunicador.", "start": 52.18, "end": 53.24, "anchored_on_pause": true}, {"i": 23, "text": "“Se acontecer alguma coisa,", "start": 53.36, "end": 54.684, "anchored_on_pause": false}, {"i": 24, "text": "não tente sair.", "start": 54.684, "end": 55.65, "anchored_on_pause": true}, {"i": 25, "text": "Apenas nos chame”,", "start": 55.79, "end": 56.53, "anchored_on_pause": true}, {"i": 26, "text": "disse ele.", "start": 56.81, "end": 57.17, "anchored_on_pause": true}, {"i": 27, "text": "Às 22 horas,", "start": 57.37, "end": 58.3, "anchored_on_pause": true}, {"i": 28, "text": "a porta foi trancada e Gabriel ficou sozinho.", "start": 58.61, "end": 60.67, "anchored_on_pause": true}, {"i": 29, "text": "Nas primeiras horas,", "start": 60.95, "end": 61.716, "anchored_on_pause": false}, {"i": 30, "text": "tudo parecia tranquilo.", "start": 61.716, "end": 62.92, "anchored_on_pause": true}, {"i": 31, "text": "Ele até começou a gravar vídeos comemorando o dinheiro que receberia e imaginando como sua vida mudaria depois daquela noite.", "start": 63.04, "end": 69.08, "anchored_on_pause": true}, {"i": 32, "text": "Mas,", "start": 69.66, "end": 69.923, "anchored_on_pause": false}, {"i": 33, "text": "exatamente às 02:13,", "start": 69.923, "end": 71.83, "anchored_on_pause": true}, {"i": 34, "text": "ouviu três batidas fortes vindas do porão.", "start": 72.17, "end": 74.235, "anchored_on_pause": false}, {"i": 35, "text": "Lembrou da segunda regra e tentou ignorar.", "start": 74.235, "end": 76.349, "anchored_on_pause": false}, {"i": 36, "text": "Alguns minutos depois,", "start": 76.349, "end": 77.62, "anchored_on_pause": true}, {"i": 37, "text": "ouviu passos no andar de cima,", "start": 77.96, "end": 79.34, "anchored_on_pause": true}, {"i": 38, "text": "mesmo sabendo que a casa só tinha um pavimento.", "start": 79.46, "end": 81.68, "anchored_on_pause": true}, {"i": 39, "text": "Pegou a lanterna e iluminou o corredor,", "start": 82.07, "end": 84.011, "anchored_on_pause": false}, {"i": 40, "text": "mas não encontrou ninguém.", "start": 84.011, "end": 84.99, "anchored_on_pause": true}, {"i": 41, "text": "Então uma voz feminina chamou seu nome lá de baixo.", "start": 85.22, "end": 88.03, "anchored_on_pause": true}, {"i": 42, "text": "Gabriel pegou o rádio e perguntou se aquilo fazia parte do desafio.", "start": 88.38, "end": 91.39, "anchored_on_pause": true}, {"i": 43, "text": "Do outro lado,", "start": 91.75, "end": 92.3, "anchored_on_pause": true}, {"i": 44, "text": "o organizador respondeu imediatamente:", "start": 92.42, "end": 94.17, "anchored_on_pause": true}, {"i": 45, "text": "“Gabriel,", "start": 94.34, "end": 94.64, "anchored_on_pause": true}, {"i": 46, "text": "escute com atenção.", "start": 94.89, "end": 95.741, "anchored_on_pause": false}, {"i": 47, "text": "Nós estamos vendo você pelas câmeras.", "start": 95.741, "end": 97.47, "anchored_on_pause": true}, {"i": 48, "text": "Não existe ninguém nessa casa além de você.” Ele tentou se acalmar,", "start": 97.59, "end": 100.94, "anchored_on_pause": true}, {"i": 49, "text": "mas a voz voltou a chamar,", "start": 101.06, "end": 102.416, "anchored_on_pause": false}, {"i": 50, "text": "dessa vez dizendo:", "start": 102.416, "end": 103.32, "anchored_on_pause": true}, {"i": 51, "text": "“Gabriel,", "start": 103.68, "end": 103.951, "anchored_on_pause": false}, {"i": 52, "text": "por favor…", "start": 103.951, "end": 104.69, "anchored_on_pause": true}, {"i": 53, "text": "eles estão mentindo.", "start": 105.1, "end": 106.01, "anchored_on_pause": true}, {"i": 54, "text": "Você precisa me tirar daqui.” Assustado,", "start": 106.13, "end": 107.43, "anchored_on_pause": true}, {"i": 55, "text": "ele se aproximou da porta do porão e percebeu que havia marcas de unhas na madeira,", "start": 107.6, "end": 112.29, "anchored_on_pause": true}, {"i": 56, "text": "como se alguém tivesse tentado sair dali.", "start": 112.47, "end": 114.3, "anchored_on_pause": true}, {"i": 57, "text": "Então o rádio chiou novamente,", "start": 114.47, "end": 115.89, "anchored_on_pause": true}, {"i": 58, "text": "mas dessa vez a voz do organizador parecia desesperada:", "start": 116.16, "end": 118.75, "anchored_on_pause": true}, {"i": 59, "text": "“Não abra o porão.", "start": 119.01, "end": 120.02, "anchored_on_pause": true}, {"i": 60, "text": "E,", "start": 120.2, "end": 120.516, "anchored_on_pause": false}, {"i": 61, "text": "principalmente,", "start": 120.516, "end": 120.89, "anchored_on_pause": true}, {"i": 62, "text": "não acredite em quem está falando com você.” Gabriel perguntou o que estava acontecendo,", "start": 121.06, "end": 125.106, "anchored_on_pause": false}, {"i": 63, "text": "mas ninguém respondeu.", "start": 125.106, "end": 125.86, "anchored_on_pause": true}, {"i": 64, "text": "Foi quando percebeu algo estranho nas câmeras:", "start": 126.32, "end": 128.4, "anchored_on_pause": false}, {"i": 65, "text": "uma delas mostrava o corredor atrás dele,", "start": 128.4, "end": 130.53, "anchored_on_pause": true}, {"i": 66, "text": "mas havia uma pessoa parada exatamente onde ele estava.", "start": 130.66, "end": 133.12, "anchored_on_pause": true}, {"i": 67, "text": "A imagem estava escura,", "start": 133.32, "end": 134.31, "anchored_on_pause": true}, {"i": 68, "text": "porém o rosto era idêntico ao seu.", "start": 134.68, "end": 136.22, "anchored_on_pause": true}, {"i": 69, "text": "Antes que pudesse entender,", "start": 136.41, "end": 137.48, "anchored_on_pause": true}, {"i": 70, "text": "alguém bateu na porta de entrada.", "start": 137.67, "end": 139.01, "anchored_on_pause": true}, {"i": 71, "text": "Uma voz igual à dele disse:", "start": 139.24, "end": 140.612, "anchored_on_pause": false}, {"i": 72, "text": "“Pode abrir.", "start": 140.612, "end": 141.07, "anchored_on_pause": true}, {"i": 73, "text": "Eu já terminei minha noite.” Gabriel olhou para o relógio.", "start": 141.21, "end": 143.48, "anchored_on_pause": true}, {"i": 74, "text": "Eram exatamente 03:33.", "start": 143.61, "end": 145.328, "anchored_on_pause": false}, {"i": 75, "text": "E então o rádio transmitiu uma última mensagem:", "start": 145.328, "end": 147.59, "anchored_on_pause": true}, {"i": 76, "text": "“Gabriel,", "start": 147.83, "end": 148.13, "anchored_on_pause": true}, {"i": 77, "text": "encontramos o corpo do participante anterior.", "start": 148.3, "end": 150.05, "anchored_on_pause": true}, {"i": 78, "text": "Mas ele está sentado na sua cadeira.”", "start": 150.41, "end": 151.91, "anchored_on_pause": null}], "words": [{"w": "Você", "start": 0.0, "seg": 0, "end": 0.285}, {"w": "aceitaria", "start": 0.285, "seg": 0, "end": 0.416}, {"w": "1", "start": 0.416, "seg": 0, "end": 0.816}, {"w": "milhão", "start": 0.816, "seg": 0, "end": 1.416}, {"w": "de", "start": 1.416