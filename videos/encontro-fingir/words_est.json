 "segments": [
  {
   "i": 0,
   "text": "Por que você finge estar ocupado quando encontra alguém conhecido?",
   "start": 0.0,
   "end": 3.09,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "Você pega o celular,",
   "start": 3.28,
   "end": 4.38,
   "anchored_on_pause": false
  },
  {
   "i": 2,
   "text": "olha para a tela,",
   "start": 4.38,
   "end": 5.29,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "começa a mexer em alguma coisa ou até muda de caminho só para evitar um simples cumprimento.",
   "start": 5.47,
   "end": 9.72,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "E o mais curioso é que,",
   "start": 10.15,
   "end": 10.96,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "muitas vezes,",
   "start": 11.1,
   "end": 11.75,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "você nem tem nada contra aquela pessoa.",
   "start": 11.75,
   "end": 13.74,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "Na verdade,",
   "start": 13.91,
   "end": 14.37,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "talvez até goste dela.",
   "start": 14.51,
   "end": 15.44,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Mas,",
   "start": 15.85,
   "end": 16.35,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "naquele instante,",
   "start": 16.47,
   "end": 17.1,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "seu cérebro parece encontrar uma maneira de escapar.",
   "start": 17.36,
   "end": 19.87,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Isso acontece porque encontrar alguém inesperadamente exige uma pequena adaptação social.",
   "start": 20.34,
   "end": 24.85,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "Você precisa decidir rapidamente se vai cumprimentar,",
   "start": 24.98,
   "end": 27.41,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "parar para conversar,",
   "start": 27.77,
   "end": 28.661,
   "anchored_on_pause": false
  },
  {
   "i": 15,
   "text": "demonstrar interesse ou simplesmente continuar andando.",
   "start": 28.661,
   "end": 31.37,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Parece algo insignificante,",
   "start": 31.49,
   "end": 32.73,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "mas existe uma pressão escondida nessa situação:",
   "start": 33.03,
   "end": 35.54,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "a possibilidade de uma interação que você não planejou.",
   "start": 35.69,
   "end": 38.3,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "E é aí que seu comportamento muda.",
   "start": 38.64,
   "end": 40.08,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "Você começa a fingir que está lendo uma mensagem,",
   "start": 40.27,
   "end": 42.38,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "procura alguma coisa na bolsa ou demonstra estar muito concentrado em uma tarefa que nem existia alguns segundos antes.",
   "start": 42.78,
   "end": 48.96,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "Só que existe um detalhe ainda mais interessante.",
   "start": 49.16,
   "end": 51.62,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Às vezes,",
   "start": 51.96,
   "end": 52.55,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "você não está evitando a pessoa.",
   "start": 52.69,
   "end": 54.24,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Está evitando a versão de você que precisa aparecer quando está perto dela.",
   "start": 54.39,
   "end": 57.93,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "Pense naquela pessoa que conheceu você em outra fase da vida.",
   "start": 58.14,
   "end": 60.8,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "Talvez um antigo colega de escola,",
   "start": 61.26,
   "end": 62.9,
   "anchored_on_pause": false
  },
  {
   "i": 28,
   "text": "alguém com quem já trabalhou ou até um conhecido que não vê há anos.",
   "start": 62.9,
   "end": 66.58,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "Quando vocês se encontram,",
   "start": 66.92,
   "end": 67.882,
   "anchored_on_pause": false
  },
  {
   "i": 30,
   "text": "não existe apenas um cumprimento.",
   "start": 67.882,
   "end": 69.34,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Existe a possibilidade de lembrar de histórias antigas,",
   "start": 69.53,
   "end": 72.02,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "explicar o que aconteceu com sua vida e responder perguntas que você nem estava preparado para ouvir.",
   "start": 72.34,
   "end": 76.63,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "E,",
   "start": 76.83,
   "end": 76.999,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "por alguns segundos,",
   "start": 76.999,
   "end": 77.82,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "você pode sentir que precisa representar novamente aquele papel que tinha naquela época.",
   "start": 78.08,
   "end": 82.05,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Por isso,",
   "start": 82.29,
   "end": 82.55,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "até um simples encontro na rua pode parecer cansativo.",
   "start": 82.68,
   "end": 85.16,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "Mas existe uma situação que revela ainda mais esse comportamento:",
   "start": 85.77,
   "end": 89.02,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "quando você vê alguém conhecido de longe e percebe que a pessoa também viu você.",
   "start": 89.4,
   "end": 93.06,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "Nesse momento,",
   "start": 93.18,
   "end": 93.69,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "os dois continuam andando,",
   "start": 94.07,
   "end": 95.32,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "fingindo que nada aconteceu.",
   "start": 95.48,
   "end": 96.68,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "Um olha para o celular,",
   "start": 96.81,
   "end": 98.119,
   "anchored_on_pause": false
  },
  {
   "i": 44,
   "text": "o outro observa uma vitrine,",
   "start": 98.119,
   "end": 99.76,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "e ambos parecem ocupados demais para reconhecer a presença um do outro.",
   "start": 99.91,
   "end": 103.51,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "O mais curioso é que,",
   "start": 104.28,
   "end": 105.175,
   "anchored_on_pause": false
  },
  {
   "i": 47,
   "text": "provavelmente,",
   "start": 105.175,
   "end": 105.864,
   "anchored_on_pause": false
  },
  {
   "i": 48,
   "text": "os dois estão pensando exatamente a mesma coisa.",
   "start": 105.864,
   "end": 108.33,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "E talvez essa seja a parte mais estranha:",
   "start": 108.78,
   "end": 110.36,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "duas pessoas que poderiam simplesmente se cumprimentar acabam participando de uma espécie de teatro silencioso,",
   "start": 110.51,
   "end": 115.5,
   "anchored_on_pause": true
  },
  {
   "i": 51,
   "text": "cada uma esperando que a outra não perceba.",
   "start": 115.89,
   "end": 118.83,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Na próxima vez que isso acontecer,",
   "start": 119.05,
   "end": 120.48,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "repare em uma coisa:",
   "start": 120.63,
   "end": 121.43,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "será que você realmente não queria conversar com aquela pessoa ou simplesmente não estava preparado para ser visto por ela?",
   "start": 121.79,
   "end": 127.93,
   "anchored_on_pause": null
  }
 ],
