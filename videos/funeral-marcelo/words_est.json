 "segments": [
  {
   "i": 0,
   "text": "Imagine passar em frente a um cemitério e descobrir que estão realizando o seu próprio funeral.",
   "start": 0.0,
   "end": 4.81,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "Foi exatamente isso que aconteceu com Marcelo,",
   "start": 5.21,
   "end": 7.22,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "um homem de 34 anos que voltava do trabalho quando viu uma multidão reunida diante de um túmulo.",
   "start": 7.69,
   "end": 12.1,
   "anchored_on_pause": false
  },
  {
   "i": 3,
   "text": "Curioso,",
   "start": 12.1,
   "end": 12.56,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "aproximou-se para entender o que estava acontecendo.",
   "start": 12.81,
   "end": 15.13,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "Mas,",
   "start": 15.43,
   "end": 15.577,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "quando olhou para a fotografia sobre o caixão,",
   "start": 15.577,
   "end": 17.54,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "sentiu as pernas perderem a força.",
   "start": 17.76,
   "end": 19.53,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Era o rosto dele.",
   "start": 19.69,
   "end": 20.64,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Marcelo começou a rir nervosamente,",
   "start": 20.82,
   "end": 22.68,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "achando que aquilo era uma brincadeira de mau gosto.",
   "start": 23.08,
   "end": 25.01,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Até ouvir uma mulher chorando e repetindo seu nome.",
   "start": 25.38,
   "end": 27.77,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Era sua própria esposa.",
   "start": 27.94,
   "end": 29.06,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "Ele tentou chamá-la,",
   "start": 29.25,
   "end": 30.091,
   "anchored_on_pause": false
  },
  {
   "i": 14,
   "text": "mas,",
   "start": 30.091,
   "end": 30.26,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "quando ela olhou em sua direção,",
   "start": 30.62,
   "end": 31.94,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "ficou completamente branca e desmaiou.",
   "start": 32.24,
   "end": 34.18,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Um homem de terno percebeu sua presença e correu até ele.",
   "start": 34.32,
   "end": 36.8,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "Segurou seu braço e sussurrou:",
   "start": 37.2,
   "end": 38.69,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "\"Você não deveria estar aqui.",
   "start": 38.85,
   "end": 40.137,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "Nós enterramos você ontem.\"",
   "start": 40.137,
   "end": 41.41,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "Marcelo se soltou e exigiu explicações.",
   "start": 41.53,
   "end": 43.66,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "O desconhecido abriu uma pasta e mostrou uma certidão de óbito,",
   "start": 43.81,
   "end": 46.92,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "documentos de identificação e até o resultado de um exame que confirmava sua morte.",
   "start": 47.04,
   "end": 51.56,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "Tudo estava registrado oficialmente.",
   "start": 51.71,
   "end": 53.843,
   "anchored_on_pause": false
  },
  {
   "i": 25,
   "text": "Desesperado,",
   "start": 53.843,
   "end": 54.51,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "Marcelo ligou para a esposa,",
   "start": 54.63,
   "end": 55.83,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "mas o celular dela estava desligado.",
   "start": 56.19,
   "end": 57.68,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Então percebeu outro detalhe:",
   "start": 57.91,
   "end": 59.28,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "ninguém naquele funeral parecia surpreso com sua aparência.",
   "start": 59.49,
   "end": 62.52,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "Todos estavam assustados,",
   "start": 62.67,
   "end": 63.76,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "como se estivessem vendo um morto voltar à vida.",
   "start": 63.98,
   "end": 66.015,
   "anchored_on_pause": false
  },
  {
   "i": 32,
   "text": "Ele decidiu procurar a polícia,",
   "start": 66.015,
   "end": 67.62,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "mas,",
   "start": 67.75,
   "end": 67.917,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "antes de sair,",
   "start": 67.917,
   "end": 68.68,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "encontrou uma fotografia caída perto do caixão.",
   "start": 69.0,
   "end": 71.12,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Era uma imagem dele entrando em um carro,",
   "start": 71.29,
   "end": 73.23,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "poucos dias antes.",
   "start": 73.39,
   "end": 74.17,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "No verso havia uma frase:",
   "start": 74.39,
   "end": 75.66,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "\"Agora ninguém vai procurar pelo verdadeiro desaparecido.\"",
   "start": 75.82,
   "end": 78.86,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "Naquele instante,",
   "start": 79.11,
   "end": 79.88,
   "anchored_on_pause": false
  },
  {
   "i": 41,
   "text": "Marcelo entendeu.",
   "start": 79.88,
   "end": 80.62,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Alguém havia preparado sua morte para assumir sua identidade e ficar com tudo o que possuía.",
   "start": 80.78,
   "end": 85.558,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "Mas a última descoberta foi ainda pior:",
   "start": 85.558,
   "end": 87.18,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "o homem de terno era seu irmão,",
   "start": 87.35,
   "end": 88.84,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "desaparecido havia quinze anos.",
   "start": 88.99,
   "end": 90.36,
   "anchored_on_pause": false
  },
  {
   "i": 46,
   "text": "E,",
   "start": 90.36,
   "end": 90.47,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "quando Marcelo levantou os olhos para procurá-lo,",
   "start": 90.62,
   "end": 92.906,
   "anchored_on_pause": false
  },
  {
   "i": 48,
   "text": "ele já estava entrando no carro da sua esposa.",
   "start": 92.906,
   "end": 94.91,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "O funeral não era uma despedida.",
   "start": 95.05,
   "end": 96.64,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "Era a comemoração de quem finalmente conseguiu roubar sua vida.",
   "start": 96.81,
   "end": 101.18,
   "anchored_on_pause": null
  }
 ],
