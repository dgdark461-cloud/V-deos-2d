start": 131.89, "end": 132.01}, {"start": 132.61, "end": 132.74}, {"start": 134.53, "end": 134.68}, {"start": 135.91, "end": 136.06}, {"start": 136.41, "end": 136.58}, {"start": 136.85, "end": 137.0}, {"start": 139.16, "end": 139.34}, {"start": 140.18, "end": 140.34}, {"start": 142.65, "end": 142.87}, {"start": 143.56, "end": 143.71}, {"start": 145.55, "end": 145.68}], "segments": [{"i": 0, "text": "Você ainda está tentando entender o aviso quando Clara começa a gritar seu nome.", "start": 1.825, "end": 5.694, "anchored_on_pause": true}, {"i": 1, "text": "O homem se aproxima dela,", "start": 5.694, "end": 6.881, "anchored_on_pause": false}, {"i": 2, "text": "mas não parece interessado em machucá-la.", "start": 6.881, "end": 8.781, "anchored_on_pause": true}, {"i": 3, "text": "Ele quer que você assista a mais uma gravação.", "start": 8.781, "end": 11.314, "anchored_on_pause": true}, {"i": 4, "text": "Na tela aparece a mesma sala,", "start": 11.314, "end": 13.385, "anchored_on_pause": false}, {"i": 5, "text": "o mesmo lobo e você segurando uma arma.", "start": 13.385, "end": 16.15, "anchored_on_pause": true}, {"i": 6, "text": "Só que,", "start": 16.15, "end": 16.428, "anchored_on_pause": false}, {"i": 7, "text": "dessa vez,", "start": 16.428, "end": 16.845, "anchored_on_pause": false}, {"i": 8, "text": "a imagem começa alguns minutos antes.", "start": 16.845, "end": 18.791, "anchored_on_pause": true}, {"i": 9, "text": "Você está discutindo com alguém atrás da câmera.", "start": 18.791, "end": 21.209, "anchored_on_pause": false}, {"i": 10, "text": "A voz é distorcida,", "start": 21.209, "end": 22.182, "anchored_on_pause": false}, {"i": 11, "text": "mas uma frase fica perfeitamente clara:", "start": 22.182, "end": 24.221, "anchored_on_pause": true}, {"i": 12, "text": "\"Se ele lembrar do que aconteceu,", "start": 24.221, "end": 26.1, "anchored_on_pause": true}, {"i": 13, "text": "o experimento acaba.\"", "start": 26.1, "end": 27.265, "anchored_on_pause": true}, {"i": 14, "text": "Você olha para o homem.", "start": 27.265, "end": 28.493, "anchored_on_pause": false}, {"i": 15, "text": "Ele não demonstra surpresa.", "start": 28.493, "end": 29.819, "anchored_on_pause": true}, {"i": 16, "text": "Pelo contrário,", "start": 29.819, "end": 30.657, "anchored_on_pause": true}, {"i": 17, "text": "parece estar esperando que você finalmente faça a pergunta certa.", "start": 30.657, "end": 33.508, "anchored_on_pause": true}, {"i": 18, "text": "\"Que experimento?\",", "start": 33.508, "end": 34.196, "anchored_on_pause": true}, {"i": 19, "text": "você pergunta.", "start": 34.196, "end": 34.927, "anchored_on_pause": true}, {"i": 20, "text": "Ele responde que as gravações foram feitas em momentos diferentes e depois montadas para fazer você acreditar que era apenas uma vítima.", "start": 34.927, "end": 41.976, "anchored_on_pause": true}, {"i": 21, "text": "Algumas cenas são verdadeiras.", "start": 41.976, "end": 43.476, "anchored_on_pause": true}, {"i": 22, "text": "Outras foram editadas.", "start": 43.476, "end": 44.657, "anchored_on_pause": true}, {"i": 23, "text": "E a pior parte é que você participou de tudo antes de perder a memória.", "start": 44.657, "end": 48.15, "anchored_on_pause": true}, {"i": 24, "text": "Clara começa a balançar a cabeça,", "start": 48.15, "end": 49.743, "anchored_on_pause": false}, {"i": 25, "text": "desesperada.", "start": 49.743, "end": 50.457, "anchored_on_pause": true}, {"i": 26, "text": "Ela diz que ele está mentindo e pede para você não acreditar em nenhuma palavra.", "start": 50.457, "end": 54.221, "anchored_on_pause": false}, {"i": 27, "text": "Mas,", "start": 54.221, "end": 54.338, "anchored_on_pause": false}, {"i": 28, "text": "quando você pergunta como ela sabe tanto,", "start": 54.338, "end": 56.14, "anchored_on_pause": false}, {"i": 29, "text": "ela fica em silêncio.", "start": 56.14, "end": 57.212, "anchored_on_pause": false}, {"i": 30, "text": "O homem aproveita:", "start": 57.212, "end": 58.15, "anchored_on_pause": true}, {"i": 31, "text": "\"Pergunte a ela por que seu nome aparece na lista dos organizadores.\"", "start": 58.15, "end": 61.389, "anchored_on_pause": false}, {"i": 32, "text": "Você sente o chão desaparecer.", "start": 61.389, "end": 62.943, "anchored_on_pause": true}, {"i": 33, "text": "Na mesa,", "start": 62.943, "end": 63.332, "anchored_on_pause": true}, {"i": 34, "text": "há uma pasta com fotografias,", "start": 63.332, "end": 64.845, "anchored_on_pause": true}, {"i": 35, "text": "anotações e uma lista de nomes.", "start": 64.845, "end": 66.971, "anchored_on_pause": true}, {"i": 36, "text": "O seu está no topo.", "start": 66.971, "end": 68.04, "anchored_on_pause": true}, {"i": 37, "text": "Ao lado,", "start": 68.04, "end": 68.706, "anchored_on_pause": true}, {"i": 38, "text": "uma palavra escrita em vermelho:", "start": 68.706, "end": 70.417, "anchored_on_pause": true}, {"i": 39, "text": "RESPONSÁVEL.", "start": 70.417, "end": 70.93, "anchored_on_pause": true}, {"i": 40, "text": "Você abre a pasta e encontra uma foto sua ao lado de Clara,", "start": 70.93, "end": 74.374, "anchored_on_pause": true}, {"i": 41, "text": "diante da mesma jaula onde o lobo era mantido.", "start": 74.374, "end": 76.984, "anchored_on_pause": false}, {"i": 42, "text": "No verso,", "start": 76.984, "end": 77.401, "anchored_on_pause": true}, {"i": 43, "text": "uma data de semanas antes do seu sequestro.", "start": 77.401, "end": 79.513, "anchored_on_pause": true}, {"i": 44, "text": "Clara finalmente fala.", "start": 79.513, "end": 80.599, "anchored_on_pause": true}, {"i": 45, "text": "Ela admite que conhecia você antes de tudo começar.", "start": 80.599, "end": 83.294, "anchored_on_pause": false}, {"i": 46, "text": "Mas garante que tentou impedir o jogo e que foi capturada quando descobriu que os organizadores planejavam uma nova rodada.", "start": 83.294, "end": 89.19, "anchored_on_pause": true}, {"i": 47, "text": "Segundo ela,", "start": 89.19, "end": 89.823, "anchored_on_pause": true}, {"i": 48, "text": "você não era o responsável pelo esquema.", "start": 89.823, "end": 91.784, "anchored_on_pause": false}, {"i": 49, "text": "Você estava infiltrado para derrubá-lo.", "start": 91.784, "end": 93.743, "anchored_on_pause": true}, {"i": 50, "text": "O homem ri.", "start": 93.743, "end": 94.239, "anchored_on_pause": true}, {"i": 51, "text": "\"É isso que fizeram você acreditar da última vez.\"", "start": 94.239, "end": 96.96, "anchored_on_pause": true}, {"i": 52, "text": "Antes que você consiga reagir,", "start": 96.96, "end": 98.625, "anchored_on_pause": true}, {"i": 53, "text": "as luzes se apagam.", "start": 98.625, "end": 99.713, "anchored_on_pause": true}, {"i": 54, "text": "Um estrondo vem do corredor.", "start": 99.713, "end": 101.08, "anchored_on_pause": true}, {"i": 55, "text": "O lobo rosna,", "start": 101.08, "end": 101.854, "anchored_on_pause": true}, {"i": 56, "text": "mas não avança.", "start": 101.854, "end": 102.783, "anchored_on_pause": true}, {"i": 57, "text": "Você escuta passos correndo e,", "start": 102.783, "end": 104.177, "anchored_on_pause": true}, {"i": 58, "text": "em seguida,", "start": 104.177, "end": 104.683, "anchored_on_pause": false}, {"i": 59, "text": "uma porta batendo.", "start": 104.683, "end": 105.608, "anchored_on_pause": true}, {"i": 60, "text": "Quando a iluminação de emergência acende,", "start": 105.608, "end": 107.862, "anchored_on_pause": false}, {"i": 61, "text": "o homem desapareceu.", "start": 107.862, "end": 108.922, "anchored_on_pause": true}, {"i": 62, "text": "Clara continua presa.", "start": 108.922, "end": 110.031, "anchored_on_pause": true}, {"i": 63, "text": "E a pasta está aberta exatamente na última página.", "start": 110.031, "end": 112.984, "anchored_on_pause": true}, {"i": 64, "text": "Há uma fotografia sua,", "start": 112.984, "end": 114.15, "anchored_on_pause": true}, {"i": 65, "text": "tirada naquela mesma noite,", "start": 114.15, "end": 115.612, "anchored_on_pause": false}, {"i": 66, "text": "segurando uma chave.", "start": 115.612, "end": 116.781, "anchored_on_pause": true}, {"i": 67, "text": "Abaixo dela,", "start": 116.781, "end": 117.512, "anchored_on_pause": false}, {"i": 68, "text": "uma frase:", "start": 117.512, "end": 118.123, "anchored_on_pause": false}, {"i": 69, "text": "\"SUJEITO AUTORIZADO A LIBERTAR O ANIMAL.\"", "start": 118.123, "end": 120.152, "anchored_on_pause": true}, {"i": 70, "text": "Você olha para o lobo.", "start": 120.152, "end": 121.244, "anchored_on_pause": false}, {"i": 71, "text": "Ele está parado diante de uma porta de metal,", "start": 121.244, "end": 123.503, "anchored_on_pause": true}, {"i": 72, "text": "arranhando o chão.", "start": 123.503, "end": 124.285, "anchored_on_pause": true}, {"i": 73, "text": "Então percebe algo que não tinha visto antes:", "start": 124.285, "end": 126.68, "anchored_on_pause": true}, {"i": 74, "text": "a chave da fotografia está pendurada no seu próprio pescoço.", "start": 126.68, "end": 129.486, "anchored_on_pause": true}, {"i": 75, "text": "Clara implora para você não abrir aquela porta.", "start": 129.486, "end": 131.974, "anchored_on_pause": false}, {"i": 76, "text": "Mas,", "start": 131.974, "end": 132.088, "anchored_on_pause": true}, {"i": 77, "text": "do outro lado,", "start": 132.088, "end": 132.658, "anchored_on_pause": true}, {"i": 78, "text": "uma voz humana começa a chamar pelo seu nome.", "start": 132.658, "end": 134.798, "anchored_on_pause": true}, {"i": 79, "text": "E você reconhece aquela voz.", "start": 134.798, "end": 136.223, "anchored_on_pause": true}, {"i": 80, "text": "É a sua.", "start": 136.223, "end": 136.611, "anchored_on_pause": true}, {"i": 81, "text": "Agora responda:", "start": 136.611, "end": 137.389, "anchored_on_pause": false}, {"i": 82, "text": "você abriria a porta para descobrir quem está do outro lado ou ajudaria Clara a fugir antes que seja tarde?", "start": 137.389, "end": 142.363, "anchored_on_pause": true}, {"i": 83, "text": "Comente sua decisão,", "start": 142.363, "end": 143.354, "anchored_on_pause": true}, {"i": 84, "text": "porque o que está atrás daquela porta pode mudar tudo o que você acredita sobre essa história.", "start": 143.354, "end": 147.588, "anchored_on_pause": null}], "words": [{"w": "Você", "start": 1.825, "end": 2.091, "seg": 0}, {"w": "ainda", "start": 2.091, "end": 2.615, "seg": 0}, {"w": "está", "start": 2.615, "end": 2.624, "seg": 0}, {"w": "tentando", "start": 2.624, "end": 3.023, "seg": 0}, {"w": "entender", "start": 3.023, "end": 3.423, "seg": 0}, {"w": "o", "start": 3.423, "end": 3.556, "seg": 0}, {"w": "aviso", "start": 3.556, "end": 4.011, "seg": 0}, {"w": "quando", "start": 4.011, "end": 4.244, "seg": 0}, {"w": "Clara", "start": 4.244, "end": 4.5, "seg": 0}, {"w": "começa", "start": 4.5, "end": 4.966, "seg": 0}, {"w": "a", "start": 4.966, "end": 5.1, "seg": 0}, {"w": "gritar", "start": 5.1, "end": 5.338, "seg": 0}, {"w": "seu", "start": 5.338, "end": 5.456, "seg": 0}, {"w": "nome.", "start": 5.456, "end": 5.694, "seg": 0}, {"w": "O", "start": 5.694, "end": 5.812, "seg": 1}, {"w": "homem", "start": 5.812, "end": 6.05, "seg": 1}, {"w": "se", "start": 6.05, "end": 6.169, "seg": 1}, {"w": "aproxima", "start": 6.169, "end": 6.644, "seg": 1}, {"w": "dela,", "start": 6.644, "end": 6.881, "seg": 1}, {"w": "mas", "start": 6.881, "end": 7.0, "seg": 2}, {"w": "não", "start": 7.0, "end": 7.238, "seg": 2}, {"w": "parece", "start": 7.238, "end": 7.932, "seg": 2}, {"w": "interessado", "start": 7.932, "end": 8.561, "seg": 2}, {"w": "em", "start": 8.561, "end": 8.686, "seg": 2}, {"w": "machucá-la.", "start": 8.686, "end": 8.781, "seg": 2}, {"w": "Ele", "start": 8.781, "end": 9.019, "seg": 3}, {"w": "quer", "start": 9.019, "end": 9.137, "seg": 3}, {"w": "que", "start": 9.137, "end": 9.256, "seg": 3}, {"w": "você", "start": 9.256, "end": 9.494, "seg": 3}, {"w": "assista", "start": 9.494, "end": 10.217, "seg": 3}, {"w": "a", "start": 10.217, "end": 10.458, "seg": 3}, {"w": "mais", "sta