 "segments": [
  {
   "i": 0,
   "text": "Você já teve a sensação de ter alguém te observando mesmo estando sozinho?",
   "start": 0.0,
   "end": 3.83,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "Foi isso que aconteceu com Mariana numa noite em que ela estava sozinha em casa.",
   "start": 4.11,
   "end": 7.34,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Era quase meia-noite.",
   "start": 7.49,
   "end": 8.49,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "A televisão estava ligada,",
   "start": 8.65,
   "end": 9.71,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "mas ela já estava com sono e decidiu ir até a cozinha pegar um copo de água.",
   "start": 10.0,
   "end": 13.39,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "Quando voltou pelo corredor,",
   "start": 13.6,
   "end": 14.7,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "teve uma sensação estranha:",
   "start": 14.84,
   "end": 16.3,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "parecia que alguém estava parado atrás dela,",
   "start": 16.3,
   "end": 18.065,
   "anchored_on_pause": false
  },
  {
   "i": 8,
   "text": "olhando diretamente para sua nuca.",
   "start": 18.065,
   "end": 19.56,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Mariana virou rapidamente,",
   "start": 19.68,
   "end": 20.872,
   "anchored_on_pause": false
  },
  {
   "i": 10,
   "text": "mas não havia ninguém.",
   "start": 20.872,
   "end": 21.77,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Ela até riu de si mesma e continuou andando.",
   "start": 21.89,
   "end": 24.16,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Só que,",
   "start": 24.3,
   "end": 24.64,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "quando entrou no quarto,",
   "start": 24.79,
   "end": 25.58,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "sentiu aquilo de novo.",
   "start": 25.71,
   "end": 26.64,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Dessa vez,",
   "start": 26.82,
   "end": 27.248,
   "anchored_on_pause": false
  },
  {
   "i": 16,
   "text": "olhou para o canto escuro perto do guarda-roupa.",
   "start": 27.248,
   "end": 29.4,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Por alguns segundos,",
   "start": 29.6,
   "end": 30.385,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "teve a impressão de enxergar uma pessoa parada ali.",
   "start": 30.385,
   "end": 32.74,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Piscou,",
   "start": 32.88,
   "end": 33.212,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "acendeu a luz e percebeu que era apenas uma pilha de roupas sobre uma cadeira.",
   "start": 33.212,
   "end": 36.735,
   "anchored_on_pause": false
  },
  {
   "i": 21,
   "text": "Mesmo assim,",
   "start": 36.735,
   "end": 37.293,
   "anchored_on_pause": false
  },
  {
   "i": 22,
   "text": "não conseguiu relaxar.",
   "start": 37.293,
   "end": 38.31,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Começou a reparar em pequenos barulhos que normalmente passariam despercebidos:",
   "start": 38.52,
   "end": 42.07,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "um estalo vindo da sala,",
   "start": 42.26,
   "end": 43.54,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "o rangido do piso e até o vento batendo na janela.",
   "start": 43.69,
   "end": 45.902,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "Então pegou o celular e ligou para uma amiga,",
   "start": 45.902,
   "end": 48.031,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "tentando se distrair.",
   "start": 48.031,
   "end": 48.95,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Enquanto conversavam,",
   "start": 49.09,
   "end": 49.9,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "Mariana foi até o banheiro.",
   "start": 50.07,
   "end": 51.07,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "Ao passar pelo espelho,",
   "start": 51.28,
   "end": 52.22,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "viu pelo canto do olho uma silhueta atrás dela.",
   "start": 52.35,
   "end": 54.23,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Virou tão rápido que quase deixou o celular cair.",
   "start": 54.36,
   "end": 56.99,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "Não havia ninguém.",
   "start": 57.16,
   "end": 57.67,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Mas,",
   "start": 57.8,
   "end": 57.924,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "dessa vez,",
   "start": 57.924,
   "end": 58.361,
   "anchored_on_pause": false
  },
  {
   "i": 36,
   "text": "ela ficou realmente assustada.",
   "start": 58.361,
   "end": 59.74,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Saiu do banheiro,",
   "start": 59.87,
   "end": 60.45,
   "anchored_on_pause": false
  },
  {
   "i": 38,
   "text": "acendeu todas as luzes e começou a verificar os cômodos.",
   "start": 60.45,
   "end": 63.331,
   "anchored_on_pause": false
  },
  {
   "i": 39,
   "text": "Sala,",
   "start": 63.331,
   "end": 63.647,
   "anchored_on_pause": false
  },
  {
   "i": 40,
   "text": "cozinha,",
   "start": 63.647,
   "end": 64.28,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "corredor,",
   "start": 64.44,
   "end": 64.931,
   "anchored_on_pause": false
  },
  {
   "i": 42,
   "text": "quarto.",
   "start": 64.931,
   "end": 65.246,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "Nada.",
   "start": 65.246,
   "end": 65.63,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "Quando finalmente se sentou no sofá,",
   "start": 65.88,
   "end": 67.341,
   "anchored_on_pause": false
  },
  {
   "i": 45,
   "text": "percebeu que estava prendendo a respiração.",
   "start": 67.341,
   "end": 69.27,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "Foi então que a amiga perguntou pelo telefone:",
   "start": 69.48,
   "end": 71.17,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "\"Você está olhando para a janela?\"",
   "start": 71.32,
   "end": 72.874,
   "anchored_on_pause": false
  },
  {
   "i": 48,
   "text": "Mariana respondeu que não.",
   "start": 72.874,
   "end": 73.789,
   "anchored_on_pause": false
  },
  {
   "i": 49,
   "text": "A amiga insistiu:",
   "start": 73.789,
   "end": 74.58,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "\"Então por que tem alguém aparecendo no reflexo atrás de você?\"",
   "start": 74.7,
   "end": 77.824,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "Mariana congelou.",
   "start": 77.824,
   "end": 78.57,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Olhou para a televisão desligada,",
   "start": 78.74,
   "end": 80.08,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "que refletia a sala inteira.",
   "start": 80.27,
   "end": 81.544,
   "anchored_on_pause": false
  },
  {
   "i": 54,
   "text": "Por um instante,",
   "start": 81.544,
   "end": 82.64,
   "anchored_on_pause": true
  },
  {
   "i": 55,
   "text": "viu uma forma escura perto do corredor.",
   "start": 82.76,
   "end": 84.366,
   "anchored_on_pause": false
  },
  {
   "i": 56,
   "text": "Levantou num salto e acendeu a luz mais próxima.",
   "start": 84.366,
   "end": 86.511,
   "anchored_on_pause": false
  },
  {
   "i": 57,
   "text": "Era apenas o casaco que tinha deixado pendurado numa cadeira.",
   "start": 86.511,
   "end": 89.16,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "Não havia ninguém na casa.",
   "start": 89.31,
   "end": 90.29,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "Mas por que tudo parecia tão real?",
   "start": 90.41,
   "end": 92.25,
   "anchored_on_pause": true
  },
  {
   "i": 60,
   "text": "Existe uma explicação para isso.",
   "start": 92.45,
   "end": 93.7,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Quando você está sozinho,",
   "start": 94.2,
   "end": 95.598,
   "anchored_on_pause": false
  },
  {
   "i": 62,
   "text": "especialmente no escuro ou em um ambiente silencioso,",
   "start": 95.598,
   "end": 98.21,
   "anchored_on_pause": true
  },
  {
   "i": 63,
   "text": "seu cérebro fica mais atento a possíveis sinais de perigo.",
   "start": 98.71,
   "end": 101.98,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "Ele tenta interpretar sombras,",
   "start": 102.17,
   "end": 103.704,
   "anchored_on_pause": false
  },
  {
   "i": 65,
   "text": "ruídos e movimentos incompletos.",
   "start": 103.704,
   "end": 105.9,
   "anchored_on_pause": true
  },
  {
   "i": 66,
   "text": "E,",
   "start": 106.02,
   "end": 106.17,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "quando não consegue identificar alguma coisa,",
   "start": 106.55,
   "end": 108.56,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "pode acabar tratando uma simples possibilidade como uma ameaça.",
   "start": 108.7,
   "end": 112.16,
   "anchored_on_pause": true
  },
  {
   "i": 69,
   "text": "É por isso que uma roupa no canto do quarto pode parecer uma pessoa,",
   "start": 112.3,
   "end": 116.02,
   "anchored_on_pause": true
  },
  {
   "i": 70,
   "text": "e um barulho qualquer pode fazer você sentir que alguém está por perto.",
   "start": 116.44,
   "end": 119.58,
   "anchored_on_pause": true
  },
  {
   "i": 71,
   "text": "O mais estranho é que,",
   "start": 119.75,
   "end": 120.87,
   "anchored_on_pause": true
  },
  {
   "i": 72,
   "text": "depois que essa sensação começa,",
   "start": 121.01,
   "end": 122.62,
   "anchored_on_pause": true
  },
  {
   "i": 73,
   "text": "você passa a procurar sinais dela em todos os lugares.",
   "start": 122.92,
   "end": 125.764,
   "anchored_on_pause": false
  },
  {
   "i": 74,
   "text": "E talvez seja justamente isso que torna a experiência tão assustadora:",
   "start": 125.764,
   "end": 129.4,
   "anchored_on_pause": true
  },
  {
   "i": 75,
   "text": "às vezes,",
   "start": 129.54,
   "end": 130.06,
   "anchored_on_pause": true
  },
  {
   "i": 76,
   "text": "o que parece estar observando você é o seu próprio cérebro tentando descobrir se existe alguém ali.",
   "start": 130.21,
   "end": 135.16,
   "anchored_on_pause": null
  }
 ],
