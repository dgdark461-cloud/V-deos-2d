 "segments": [
  {
   "i": 0,
   "text": "Seu cérebro pode criar lembranças de coisas que nunca aconteceram!",
   "start": 0.0,
   "end": 3.08,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "E o mais assustador é que você pode jurar que viveu aquele momento,",
   "start": 3.29,
   "end": 6.51,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "lembrar dos detalhes e até sentir saudade de algo que nunca existiu.",
   "start": 6.75,
   "end": 10.36,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "Foi exatamente isso que aconteceu com Rafael.",
   "start": 10.5,
   "end": 12.38,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Desde pequeno,",
   "start": 12.56,
   "end": 12.92,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "ele lembrava de uma viagem à praia com a família.",
   "start": 12.92,
   "end": 15.449,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "Na memória dele,",
   "start": 15.449,
   "end": 16.287,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "tinha uns cinco anos,",
   "start": 16.287,
   "end": 17.23,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "estava construindo um castelo de areia enquanto o pai tirava fotos.",
   "start": 17.4,
   "end": 20.32,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Em determinado momento,",
   "start": 20.44,
   "end": 21.932,
   "anchored_on_pause": false
  },
  {
   "i": 10,
   "text": "uma onda maior veio e levou seu brinquedo.",
   "start": 21.932,
   "end": 23.61,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Ele começou a chorar,",
   "start": 23.83,
   "end": 24.718,
   "anchored_on_pause": false
  },
  {
   "i": 12,
   "text": "mas o pai correu até a água,",
   "start": 24.718,
   "end": 25.9,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "pegou o brinquedo e voltou carregando Rafael no colo.",
   "start": 26.06,
   "end": 28.47,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "Era uma lembrança tão viva que ele conseguia imaginar o cheiro do mar,",
   "start": 28.67,
   "end": 32.01,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "o barulho das ondas e até a cor do guarda-sol.",
   "start": 32.19,
   "end": 34.46,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Anos depois,",
   "start": 34.6,
   "end": 35.122,
   "anchored_on_pause": false
  },
  {
   "i": 17,
   "text": "durante um almoço de família,",
   "start": 35.122,
   "end": 36.7,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "Rafael resolveu contar essa história.",
   "start": 37.16,
   "end": 38.529,
   "anchored_on_pause": false
  },
  {
   "i": 19,
   "text": "Mas,",
   "start": 38.529,
   "end": 38.67,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "assim que terminou,",
   "start": 38.85,
   "end": 39.85,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "a mãe ficou olhando para ele,",
   "start": 40.02,
   "end": 41.22,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "confusa.",
   "start": 41.48,
   "end": 41.91,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Então perguntou:",
   "start": 42.17,
   "end": 42.961,
   "anchored_on_pause": false
  },
  {
   "i": 24,
   "text": "\"Rafael,",
   "start": 42.961,
   "end": 43.38,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "de que viagem você está falando?\"",
   "start": 43.68,
   "end": 44.96,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "Ele respondeu que era aquela praia onde o pai tinha salvado seu brinquedo.",
   "start": 45.11,
   "end": 48.16,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "O pai começou a rir e revelou algo que o deixou completamente sem reação:",
   "start": 48.29,
   "end": 52.45,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "naquela época,",
   "start": 52.58,
   "end": 53.185,
   "anchored_on_pause": false
  },
  {
   "i": 29,
   "text": "a família nem tinha ido à praia.",
   "start": 53.185,
   "end": 54.406,
   "anchored_on_pause": false
  },
  {
   "i": 30,
   "text": "Na verdade,",
   "start": 54.406,
   "end": 54.99,
   "anchored_on_pause": false
  },
  {
   "i": 31,
   "text": "aquela viagem aconteceu dois anos antes de Rafael nascer.",
   "start": 54.99,
   "end": 57.853,
   "anchored_on_pause": false
  },
  {
   "i": 32,
   "text": "Ele ficou convencido de que os pais estavam confundindo as datas,",
   "start": 57.853,
   "end": 61.11,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "até que a irmã mostrou uma fotografia antiga.",
   "start": 61.5,
   "end": 63.66,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Na imagem,",
   "start": 63.78,
   "end": 64.206,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "o pai aparecia exatamente como Rafael lembrava,",
   "start": 64.206,
   "end": 66.6,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "segurando uma criança no colo,",
   "start": 66.97,
   "end": 68.533,
   "anchored_on_pause": false
  },
  {
   "i": 37,
   "text": "perto de um guarda-sol.",
   "start": 68.533,
   "end": 69.247,
   "anchored_on_pause": false
  },
  {
   "i": 38,
   "text": "Só que aquela criança não era ele.",
   "start": 69.247,
   "end": 70.99,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Era seu primo,",
   "start": 71.22,
   "end": 71.81,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "que tinha a mesma idade que Rafael imaginava ter naquela lembrança.",
   "start": 71.94,
   "end": 75.44,
   "anchored_on_pause": false
  },
  {
   "i": 41,
   "text": "De repente,",
   "start": 75.44,
   "end": 76.024,
   "anchored_on_pause": false
  },
  {
   "i": 42,
   "text": "tudo começou a fazer sentido.",
   "start": 76.024,
   "end": 77.245,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "Durante anos,",
   "start": 77.245,
   "end": 77.94,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "Rafael tinha ouvido aquela história,",
   "start": 78.09,
   "end": 79.46,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "visto aquela fotografia e imaginado como teria sido estar naquele lugar.",
   "start": 79.63,
   "end": 84.18,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "Com o tempo,",
   "start": 84.38,
   "end": 85.189,
   "anchored_on_pause": false
  },
  {
   "i": 47,
   "text": "seu cérebro misturou as imagens,",
   "start": 85.189,
   "end": 86.87,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "os relatos e a imaginação,",
   "start": 87.08,
   "end": 89.03,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "até transformar tudo em uma lembrança pessoal.",
   "start": 89.2,
   "end": 91.314,
   "anchored_on_pause": false
  },
  {
   "i": 50,
   "text": "E isso pode acontecer porque nossa memória não funciona como uma câmera que grava tudo perfeitamente.",
   "start": 91.314,
   "end": 96.131,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "Cada vez que você recorda um acontecimento,",
   "start": 96.131,
   "end": 98.236,
   "anchored_on_pause": false
  },
  {
   "i": 52,
   "text": "seu cérebro reconstrói aquela experiência,",
   "start": 98.236,
   "end": 100.02,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "e informações de outras fontes podem acabar entrando nessa reconstrução.",
   "start": 100.33,
   "end": 104.25,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "Por isso,",
   "start": 104.65,
   "end": 105.129,
   "anchored_on_pause": false
  },
  {
   "i": 55,
   "text": "uma história que alguém contou,",
   "start": 105.129,
   "end": 106.63,
   "anchored_on_pause": true
  },
  {
   "i": 56,
   "text": "uma fotografia ou até uma cena que você imaginou muitas vezes pode parecer algo que realmente viveu.",
   "start": 106.79,
   "end": 111.67,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "E agora pense:",
   "start": 111.83,
   "end": 112.48,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "quantas lembranças da sua infância você tem certeza de que aconteceram,",
   "start": 112.78,
   "end": 116.66,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "mas talvez sejam apenas histórias que ouviu tantas vezes que seu cérebro acabou transformando em memórias?",
   "start": 116.96,
   "end": 122.65,
   "anchored_on_pause": null
  }
 ],
