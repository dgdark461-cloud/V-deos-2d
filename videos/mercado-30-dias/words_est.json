 ],
 "segments": [
  {
   "i": 0,
   "text": "Você ficou 30 dias preso num supermercado com comida para uma vida inteira.",
   "start": 0.0,
   "end": 4.31,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "E o problema nunca foi a comida.",
   "start": 4.43,
   "end": 5.84,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Mercado 24 horas,",
   "start": 6.03,
   "end": 6.95,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "você é o repositor da madrugada.",
   "start": 7.11,
   "end": 8.76,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Às 23h40,",
   "start": 8.95,
   "end": 9.2,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "a Dona Marta,",
   "start": 9.2,
   "end": 10.02,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "do caixa 3,",
   "start": 10.23,
   "end": 10.91,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "sai correndo atrás do neto.",
   "start": 10.91,
   "end": 12.71,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Tranca tudo,",
   "start": 12.97,
   "end": 13.42,
   "anchored_on_pause": false
  },
  {
   "i": 9,
   "text": "volto em uma hora.",
   "start": 13.42,
   "end": 14.25,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "Ela não volta.",
   "start": 14.47,
   "end": 14.93,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Problema 1,",
   "start": 15.19,
   "end": 15.7,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "a frente é toda de vidro.",
   "start": 15.86,
   "end": 16.9,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "Você desce a porta de aço na manivela,",
   "start": 17.13,
   "end": 19.2,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "quatro minutos de barulho,",
   "start": 19.39,
   "end": 20.64,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "com plateia.",
   "start": 20.82,
   "end": 21.42,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Problema 2,",
   "start": 21.56,
   "end": 22.32,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "a energia cai.",
   "start": 22.45,
   "end": 23.21,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "Duas toneladas de carne começam a estragar.",
   "start": 23.47,
   "end": 25.54,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Então,",
   "start": 25.69,
   "end": 26.044,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "a primeira semana é churrasco no telhado,",
   "start": 26.044,
   "end": 27.69,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "picanha todo dia.",
   "start": 27.89,
   "end": 28.71,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "Melhor emprego da sua vida.",
   "start": 28.84,
   "end": 29.94,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Lá de cima,",
   "start": 30.15,
   "end": 30.927,
   "anchored_on_pause": false
  },
  {
   "i": 24,
   "text": "você descobre a regra deles.",
   "start": 30.927,
   "end": 32.21,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Às 8 da manhã,",
   "start": 32.4,
   "end": 33.406,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "centenas na porta,",
   "start": 33.406,
   "end": 34.46,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "às 10 da noite,",
   "start": 34.63,
   "end": 35.488,
   "anchored_on_pause": false
  },
  {
   "i": 28,
   "text": "vão embora.",
   "start": 35.488,
   "end": 36.03,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "Eles não caçam,",
   "start": 36.15,
   "end": 37.147,
   "anchored_on_pause": false
  },
  {
   "i": 30,
   "text": "eles retêm.",
   "start": 37.147,
   "end": 37.58,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Ainda vêm fazer compras no horário de sempre.",
   "start": 37.94,
   "end": 39.65,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Problema 3,",
   "start": 39.77,
   "end": 40.506,
   "anchored_on_pause": false
  },
  {
   "i": 33,
   "text": "no meio da noite,",
   "start": 40.506,
   "end": 41.462,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "a luz volta sozinha e o letreiro acende,",
   "start": 41.462,
   "end": 44.03,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "aberto 24 horas.",
   "start": 44.26,
   "end": 45.55,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Desliga em segundos,",
   "start": 45.86,
   "end": 46.54,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "tarde demais.",
   "start": 46.68,
   "end": 47.55,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "Agora eles empurram a porta,",
   "start": 47.72,
   "end": 49.248,
   "anchored_on_pause": false
  },
  {
   "i": 39,
   "text": "e a luz também chamou os vivos.",
   "start": 49.248,
   "end": 50.7,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "Você baixa uma cesta na corda,",
   "start": 50.82,
   "end": 52.43,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "lata em troca de pilha,",
   "start": 52.56,
   "end": 54.0,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "remédio,",
   "start": 54.12,
   "end": 54.707,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "notícia.",
   "start": 54.707,
   "end": 55.22,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "No dia 18,",
   "start": 55.34,
   "end": 56.06,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "já tem fila.",
   "start": 56.18,
   "end": 56.69,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "Até que a cesta volta com um bilhete,",
   "start": 56.9,
   "end": 58.614,
   "anchored_on_pause": false
  },
  {
   "i": 47,
   "text": "letra de criança.",
   "start": 58.614,
   "end": 59.4,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "Os homens da caminhonete vêm hoje.",
   "start": 59.53,
   "end": 61.3,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "Eles querem tudo.",
   "start": 61.45,
   "end": 62.14,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "Você desce a escada.",
   "start": 62.26,
   "end": 62.978,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "Sobe uma menina com um vira-lata no colo.",
   "start": 62.978,
   "end": 64.88,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Problema quatro,",
   "start": 65.04,
   "end": 65.74,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "cinco homens e uma corrente.",
   "start": 65.86,
   "end": 67.396,
   "anchored_on_pause": false
  },
  {
   "i": 54,
   "text": "Se arrancarem a porta,",
   "start": 67.396,
   "end": 68.481,
   "anchored_on_pause": false
  },
  {
   "i": 55,
   "text": "os mortos entram junto.",
   "start": 68.481,
   "end": 69.52,
   "anchored_on_pause": true
  },
  {
   "i": 56,
   "text": "Então,",
   "start": 69.82,
   "end": 70.08,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "como tirar cinco homens da sua porta sem abrir ela?",
   "start": 70.24,
   "end": 72.96,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "Você não tira.",
   "start": 73.21,
   "end": 73.81,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "Você abre a loja.",
   "start": 73.99,
   "end": 75.05,
   "anchored_on_pause": true
  },
  {
   "i": 60,
   "text": "Você liga o letreiro.",
   "start": 75.2,
   "end": 76.09,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Aberto 24 horas,",
   "start": 76.23,
   "end": 77.46,
   "anchored_on_pause": true
  },
  {
   "i": 62,
   "text": "e todo morto da cidade vem fazer compras.",
   "start": 77.68,
   "end": 79.61,
   "anchored_on_pause": true
  },
  {
   "i": 63,
   "text": "Bem onde a caminhonete está parada.",
   "start": 79.76,
   "end": 81.41,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "Ela foge,",
   "start": 81.61,
   "end": 82.029,
   "anchored_on_pause": false
  },
  {
   "i": 65,
   "text": "arrastando a corrente,",
   "start": 82.029,
   "end": 83.06,
   "anchored_on_pause": true
  },
  {
   "i": 66,
   "text": "e o barulho leva a multidão junto.",
   "start": 83.33,
   "end": 84.6,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "Dia 30.",
   "start": 84.74,
   "end": 85.21,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "Inventário.",
   "start": 85.33,
   "end": 85.87,
   "anchored_on_pause": true
  },
  {
   "i": 69,
   "text": "Latas,",
   "start": 86.06,
   "end": 86.295,
   "anchored_on_pause": false
  },
  {
   "i": 70,
   "text": "milhares.",
   "start": 86.295,
   "end": 86.999,
   "anchored_on_pause": false
  },
  {
   "i": 71,
   "text": "Pessoas,",
   "start": 86.999,
   "end": 87.453,
   "anchored_on_pause": false
  },
  {
   "i": 72,
   "text": "duas.",
   "start": 87.453,
   "end": 87.7,
   "anchored_on_pause": true
  },
  {
   "i": 73,
   "text": "Cachorro,",
   "start": 87.82,
   "end": 88.24,
   "anchored_on_pause": true
  },
  {
   "i": 74,
   "text": "um.",
   "start": 88.4,
   "end": 88.75,
   "anchored_on_pause": true
  },
  {
   "i": 75,
   "text": "Sozinho,",
   "start": 88.99,
   "end": 89.415,
   "anchored_on_pause": false
  },
  {
   "i": 76,
   "text": "você não passava do dia 20.",
   "start": 89.415,
   "end": 91.0,
   "anchored_on_pause": true
  },
  {
   "i": 77,
   "text": "E todo dia,",
   "start": 91.29,
   "end": 92.125,
   "anchored_on_pause": false
  },
  {
   "i": 78,
   "text": "às 5 horas e 58 minutos,",
   "start": 92.125,
   "end": 94.19,
   "anchored_on_pause": true
  },
  {
   "i": 79,
   "text": "alguém bate na porta dos fundos.",
   "start": 94.32,
   "end": 95.55,
   "anchored_on_pause": true
  },
  {
   "i": 80,
   "text": "É a dona Marta.",
   "start": 95.7,
   "end": 96.51,
   "anchored_on_pause": true
  },
  {
   "i": 81,
   "text": "Em 22 anos,",
   "start": 96.77,
   "end": 97.747,
   "anchored_on_pause": false
  },
  {
   "i": 82,
   "text": "ela nunca faltou.",
   "start": 97.747,
   "end": 98.58,
   "anchored_on_pause": null
  }
 ],
