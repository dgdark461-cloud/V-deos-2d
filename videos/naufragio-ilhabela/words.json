 "segments": [
  {
   "i": 0,
   "text": "E se você sobrevivesse ao maior naufrágio da história do Brasil,",
   "start": 0.0,
   "end": 3.37,
   "anchored_on_pause": false
  },
  {
   "i": 1,
   "text": "nadando no breu da madrugada até uma ilha isolada,",
   "start": 3.37,
   "end": 6.37,
   "anchored_on_pause": false
  },
  {
   "i": 2,
   "text": "apenas para descobrir que o verdadeiro terror te esperava na terra firme?",
   "start": 6.37,
   "end": 10.22,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "Não celebre antes da hora:",
   "start": 10.36,
   "end": 11.89,
   "anchored_on_pause": false
  },
  {
   "i": 4,
   "text": "estar vivo não significa estar salvo.",
   "start": 11.89,
   "end": 14.13,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "Foi exatamente esse pesadelo que atingiu Alex na tempestade de 1916,",
   "start": 14.4,
   "end": 19.43,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "quando o luxuoso transatlântico Príncipe de Astúrias colidiu contra os rochedos de Ilhabela e afundou em menos de dez minutos.",
   "start": 19.83,
   "end": 27.04,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "Arremessado nas águas revoltas entre destroços e corpos,",
   "start": 27.17,
   "end": 30.69,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "ele lutou contra a correnteza até alcançar as pedras afiadas de uma praia desconhecida.",
   "start": 30.85,
   "end": 35.18,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Exausto e com o corpo coberto de cortes,",
   "start": 35.4,
   "end": 37.63,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "Alex desmaiou na areia molhada.",
   "start": 37.95,
   "end": 39.491,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "Mas,",
   "start": 39.491,
   "end": 39.712,
   "anchored_on_pause": false
  },
  {
   "i": 12,
   "text": "ao abrir os olhos horas depois,",
   "start": 39.712,
   "end": 41.74,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "ainda na escuridão da noite,",
   "start": 42.02,
   "end": 43.28,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "percebeu que o silêncio da praia era uma ilusão mortal.",
   "start": 43.55,
   "end": 46.41,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Siga as regras para não virar presa:",
   "start": 46.59,
   "end": 48.655,
   "anchored_on_pause": false
  },
  {
   "i": 16,
   "text": "primeira regra,",
   "start": 48.655,
   "end": 49.429,
   "anchored_on_pause": false
  },
  {
   "i": 17,
   "text": "nunca fique perto da água após um naufrágio.",
   "start": 49.429,
   "end": 51.44,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "O cheiro de sangue atrai tubarões até o raso e a maré alta pode te puxar de volta para o abismo.",
   "start": 51.56,
   "end": 56.13,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Segunda regra:",
   "start": 56.31,
   "end": 56.985,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "não tente andar no breu por uma ilha desconhecida.",
   "start": 56.985,
   "end": 59.553,
   "anchored_on_pause": false
  },
  {
   "i": 21,
   "text": "Os penhascos são falsos e um passo em falso significa uma queda fatal.",
   "start": 59.553,
   "end": 63.01,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "Terceira regra:",
   "start": 63.2,
   "end": 64.05,
   "anchored_on_pause": false
  },
  {
   "i": 23,
   "text": "mantenha-se em silêncio absoluto.",
   "start": 64.05,
   "end": 65.74,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "Ao tatear os bolsos,",
   "start": 65.86,
   "end": 66.84,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Alex encontra uma caixa de fósforos molhada,",
   "start": 67.14,
   "end": 69.5,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "onde apenas um único palito se salvou.",
   "start": 69.63,
   "end": 71.64,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "Ao riscar a chama hesitante na escuridão,",
   "start": 71.82,
   "end": 74.0,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "a luz fraca revela o horror absoluto:",
   "start": 74.26,
   "end": 76.25,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "a ilha não está deserta.",
   "start": 76.45,
   "end": 77.83,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "A poucos metros dele,",
   "start": 77.96,
   "end": 79.119,
   "anchored_on_pause": false
  },
  {
   "i": 31,
   "text": "dezenas de ratazanas gigantescas,",
   "start": 79.119,
   "end": 81.29,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "atraídas pelo odor dos destroços e das vítimas na orla,",
   "start": 81.57,
   "end": 84.65,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "começam a se aproximar em bando,",
   "start": 84.87,
   "end": 86.04,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "cercando o local.",
   "start": 86.26,
   "end": 87.02,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "O sangue gela.",
   "start": 87.3,
   "end": 88.125,
   "anchored_on_pause": false
  },
  {
   "i": 36,
   "text": "O único palito de fósforo apaga nos seus dedos,",
   "start": 88.125,
   "end": 90.45,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "devolvendo tudo ao breu total,",
   "start": 90.58,
   "end": 91.98,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "enquanto o barulho de centenas de garras arranhando as pedras começa a avançar na sua direção.",
   "start": 92.16,
   "end": 96.87,
   "anchored_on_pause": null
  }
 ],
