 "segments": [
  {
   "i": 0,
   "text": "Quando Daniel abriu a porta,",
   "start": -1.473,
   "end": 0.327,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "não havia pantera nenhuma.",
   "start": 0.327,
   "end": 2.327,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Havia um homem de capa de chuva,",
   "start": 2.327,
   "end": 3.867,
   "anchored_on_pause": false
  },
  {
   "i": 3,
   "text": "parado,",
   "start": 3.867,
   "end": 4.239,
   "anchored_on_pause": false
  },
  {
   "i": 4,
   "text": "segurando uma lanterna apagada e um sorriso que não combinava com a floresta.",
   "start": 4.239,
   "end": 8.195,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "“Boa noite,",
   "start": 8.195,
   "end": 8.708,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "Daniel.",
   "start": 8.708,
   "end": 8.964,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "Eu sou o motivo de você estar aqui.” Daniel tentou fechar a porta,",
   "start": 8.964,
   "end": 11.977,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "mas Helena o puxou para trás e finalmente contou a verdade.",
   "start": 11.977,
   "end": 14.934,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Aquilo nunca foi um desafio de resistência.",
   "start": 14.934,
   "end": 17.056,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "Era uma caçada,",
   "start": 17.056,
   "end": 17.885,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "transmitida ao vivo para pessoas que apostavam quanto tempo cada participante conseguiria sobreviver.",
   "start": 17.885,
   "end": 22.635,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "A câmera escondida atrás do quadro era a prova.",
   "start": 22.635,
   "end": 24.939,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "As pernas de Daniel quase falharam.",
   "start": 24.939,
   "end": 26.333,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "Ele perguntou por que ela estava tão calma,",
   "start": 26.333,
   "end": 28.24,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "e Helena respondeu que já tinha passado por aquilo antes.",
   "start": 28.24,
   "end": 30.709,
   "anchored_on_pause": false
  },
  {
   "i": 16,
   "text": "Ela havia sido a participante anterior,",
   "start": 30.709,
   "end": 32.454,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "a única que saiu viva.",
   "start": 32.454,
   "end": 33.417,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "Em troca da liberdade,",
   "start": 33.417,
   "end": 34.683,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "aceitou voltar como isca:",
   "start": 34.683,
   "end": 36.108,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "ganhar a confiança de cada novo competidor e mantê-lo dentro da cabana até o caçador chegar.",
   "start": 36.108,
   "end": 40.9,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "“Eu sinto muito”,",
   "start": 40.9,
   "end": 41.617,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "disse ela,",
   "start": 41.617,
   "end": 42.15,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "com os olhos molhados.",
   "start": 42.15,
   "end": 43.15,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "O homem entrou devagar,",
   "start": 43.15,
   "end": 44.15,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "olhando para os dois como quem escolhe uma presa.",
   "start": 44.15,
   "end": 46.295,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "“A pantera era só para assustar vocês.",
   "start": 46.295,
   "end": 48.15,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "O prêmio de verdade é você,",
   "start": 48.15,
   "end": 49.318,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Daniel.” Foi então que todas as luzes da cabana se apagaram.",
   "start": 49.318,
   "end": 52.357,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "Daniel ouviu um rosnado grave,",
   "start": 52.357,
   "end": 53.714,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "e ele não vinha de fora.",
   "start": 53.714,
   "end": 55.258,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Vinha de dentro da casa,",
   "start": 55.258,
   "end": 56.086,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "a poucos metros.",
   "start": 56.086,
   "end": 56.829,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "Algo enorme se movia entre os móveis,",
   "start": 56.829,
   "end": 58.984,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "sem pressa.",
   "start": 58.984,
   "end": 59.133,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "O sorriso do homem desapareceu.",
   "start": 59.133,
   "end": 60.752,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Helena segurou o braço de Daniel e sussurrou a última coisa que ele esperava ouvir:",
   "start": 60.752,
   "end": 65.023,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "“Fui eu quem abriu a jaula.",
   "start": 65.023,
   "end": 66.15,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "Eu nunca fui isca dele.",
   "start": 66.15,
   "end": 67.186,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Eu voltei para acabar com isso.” A lanterna do homem acendeu de repente,",
   "start": 67.186,
   "end": 70.352,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "e o feixe de luz mostrou dois olhos amarelos ao lado de Helena.",
   "start": 70.352,
   "end": 73.332,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "A pantera não olhava para ela.",
   "start": 73.332,
   "end": 75.465,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Olhava para o caçador.",
   "start": 75.465,
   "end": 76.781,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "Ele recuou,",
   "start": 76.781,
   "end": 77.25,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "tropeçou na porta e correu para dentro da floresta,",
   "start": 77.25,
   "end": 79.206,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "e o rosnado o seguiu na escuridão.",
   "start": 79.206,
   "end": 80.927,
   "anchored_on_pause": false
  },
  {
   "i": 46,
   "text": "Daniel ouviu galhos quebrando,",
   "start": 80.927,
   "end": 82.242,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "passos desesperados e uma respiração pesada que ficava cada vez mais distante.",
   "start": 82.242,
   "end": 86.086,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "Helena nem se mexeu.",
   "start": 86.086,
   "end": 87.036,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "Daniel ficou ali,",
   "start": 87.036,
   "end": 88.003,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "sem entender nada,",
   "start": 88.003,
   "end": 88.858,
   "anchored_on_pause": true
  },
  {
   "i": 51,
   "text": "até ouvir o grito ao longe.",
   "start": 88.858,
   "end": 90.403,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Quando tudo silenciou,",
   "start": 90.403,
   "end": 91.331,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "Helena olhou para a câmera,",
   "start": 91.331,
   "end": 92.79,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "que ainda piscava uma luz vermelha.",
   "start": 92.79,
   "end": 94.863,
   "anchored_on_pause": false
  },
  {
   "i": 55,
   "text": "“Eles continuam assistindo”,",
   "start": 94.863,
   "end": 96.308,
   "anchored_on_pause": true
  },
  {
   "i": 56,
   "text": "disse ela.",
   "start": 96.308,
   "end": 96.883,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "E,",
   "start": 96.883,
   "end": 97.067,
   "anchored_on_pause": false
  },
  {
   "i": 58,
   "text": "naquele instante,",
   "start": 97.067,
   "end": 98.167,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "Daniel ouviu três batidas na porta dos fundos.",
   "start": 98.167,
   "end": 100.866,
   "anchored_on_pause": null
  }
 ],
