 ],
 "segments": [
  {
   "i": 0,
   "text": "Se alguém te parasse na rua e perguntasse:",
   "start": -0.572,
   "end": 2.228,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "você preferiria ficar sozinho em uma floresta com uma mulher ou com uma pantera-negra?",
   "start": 2.228,
   "end": 6.857,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Você provavelmente escolheria a mulher,",
   "start": 6.857,
   "end": 8.876,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "mas foi exatamente essa decisão que colocou Daniel em uma situação que ele jamais imaginou viver.",
   "start": 8.876,
   "end": 13.931,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Tudo começou quando ele aceitou participar de um desafio em troca de uma grande quantia em dinheiro.",
   "start": 13.931,
   "end": 18.314,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "A regra era simples:",
   "start": 18.314,
   "end": 19.137,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "passar uma noite inteira em uma floresta isolada,",
   "start": 19.137,
   "end": 21.761,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "acompanhado de uma mulher desconhecida.",
   "start": 21.761,
   "end": 23.62,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Mas havia um detalhe que ninguém explicou.",
   "start": 23.62,
   "end": 25.342,
   "anchored_on_pause": false
  },
  {
   "i": 9,
   "text": "Antes de entrar,",
   "start": 25.342,
   "end": 25.981,
   "anchored_on_pause": false
  },
  {
   "i": 10,
   "text": "Daniel viu uma pantera-negra dentro de uma jaula,",
   "start": 25.981,
   "end": 28.15,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "sendo transportada em um veículo.",
   "start": 28.15,
   "end": 29.525,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Quando perguntou o que aquele animal estava fazendo ali,",
   "start": 29.525,
   "end": 32.15,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "recebeu uma resposta estranha:",
   "start": 32.15,
   "end": 33.32,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "\"É melhor você não se preocupar com ela.\"",
   "start": 33.32,
   "end": 34.964,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Pouco depois,",
   "start": 34.964,
   "end": 35.43,
   "anchored_on_pause": false
  },
  {
   "i": 16,
   "text": "ele foi levado até uma cabana no meio da floresta,",
   "start": 35.43,
   "end": 37.651,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "onde conheceu Helena,",
   "start": 37.651,
   "end": 38.593,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "uma mulher aparentemente tranquila,",
   "start": 38.593,
   "end": 40.36,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "que não demonstrava medo de estar naquele lugar.",
   "start": 40.36,
   "end": 42.403,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "Assim que os responsáveis foram embora,",
   "start": 42.403,
   "end": 44.115,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "Daniel perguntou se ela sabia por que estavam fazendo aquele desafio.",
   "start": 44.115,
   "end": 47.212,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "Helena apenas respondeu:",
   "start": 47.212,
   "end": 48.425,
   "anchored_on_pause": false
  },
  {
   "i": 23,
   "text": "\"Você realmente acredita que isso é um jogo?\"",
   "start": 48.425,
   "end": 50.477,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "Ele começou a rir,",
   "start": 50.477,
   "end": 51.291,
   "anchored_on_pause": false
  },
  {
   "i": 25,
   "text": "achando que ela estava tentando assustá-lo.",
   "start": 51.291,
   "end": 53.152,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "Mas,",
   "start": 53.152,
   "end": 53.268,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "alguns minutos depois,",
   "start": 53.268,
   "end": 54.421,
   "anchored_on_pause": false
  },
  {
   "i": 28,
   "text": "os dois ouviram um barulho vindo de fora.",
   "start": 54.421,
   "end": 56.15,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "Quando Daniel olhou pela janela,",
   "start": 56.15,
   "end": 57.71,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "percebeu que a jaula estava aberta.",
   "start": 57.71,
   "end": 59.337,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "A pantera havia desaparecido.",
   "start": 59.337,
   "end": 60.762,
   "anchored_on_pause": false
  },
  {
   "i": 32,
   "text": "Ele pegou uma lanterna e começou a procurar sinais do animal,",
   "start": 60.762,
   "end": 63.756,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "mas Helena segurou seu braço e pediu que não saísse.",
   "start": 63.756,
   "end": 66.15,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "Então ela revelou algo que fez o sangue de Daniel gelar:",
   "start": 66.15,
   "end": 68.625,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "aquela pantera não tinha escapado por acidente.",
   "start": 68.625,
   "end": 70.88,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Alguém havia aberto a jaula de propósito.",
   "start": 70.88,
   "end": 72.741,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Daniel perguntou quem faria uma coisa dessas.",
   "start": 72.741,
   "end": 74.555,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "Helena não respondeu.",
   "start": 74.555,
   "end": 75.57,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Em vez disso,",
   "start": 75.57,
   "end": 76.077,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "caminhou até uma parede da cabana e retirou um pequeno quadro,",
   "start": 76.077,
   "end": 79.279,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "revelando uma câmera escondida atrás dele.",
   "start": 79.279,
   "end": 81.186,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Ela olhou diretamente para a lente e disse:",
   "start": 81.186,
   "end": 83.319,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "\"Ele já chegou.\"",
   "start": 83.319,
   "end": 84.043,
   "anchored_on_pause": false
  },
  {
   "i": 44,
   "text": "Nesse instante,",
   "start": 84.043,
   "end": 84.781,
   "anchored_on_pause": false
  },
  {
   "i": 45,
   "text": "três batidas fortes ecoaram na porta.",
   "start": 84.781,
   "end": 86.653,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "Daniel apontou a lanterna,",
   "start": 86.653,
   "end": 88.15,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "esperando encontrar a pantera do outro lado.",
   "start": 88.15,
   "end": 90.821,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "Mas,",
   "start": 90.821,
   "end": 90.988,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "quando Helena sussurrou o que realmente estava esperando por eles naquela noite,",
   "start": 90.988,
   "end": 96.098,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "ele percebeu que o animal talvez fosse o menor dos seus problemas.",
   "start": 96.098,
   "end": 99.69,
   "anchored_on_pause": null
  }
 ],
