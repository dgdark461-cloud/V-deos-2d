 "segments": [
  {
   "i": 0,
   "text": "Por que você começa a andar mais rápido quando percebe alguém atrás de você?",
   "start": -0.6,
   "end": 4.05,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "Você está andando tranquilamente,",
   "start": 4.05,
   "end": 6.15,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "pensando na vida,",
   "start": 6.15,
   "end": 7.156,
   "anchored_on_pause": false
  },
  {
   "i": 3,
   "text": "até ouvir passos vindo na mesma direção.",
   "start": 7.156,
   "end": 9.643,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "No começo,",
   "start": 9.643,
   "end": 10.341,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "nem liga.",
   "start": 10.341,
   "end": 10.844,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "Mas,",
   "start": 10.844,
   "end": 11.012,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "depois de alguns segundos,",
   "start": 11.012,
   "end": 12.397,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "percebe que aqueles passos continuam ali.",
   "start": 12.397,
   "end": 14.964,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "Você acelera um pouco.",
   "start": 14.964,
   "end": 16.495,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "A pessoa também.",
   "start": 16.495,
   "end": 17.469,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Você atravessa a rua,",
   "start": 17.469,
   "end": 18.914,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "olha discretamente pelo canto do olho e,",
   "start": 18.914,
   "end": 21.724,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "sem perceber,",
   "start": 21.724,
   "end": 22.468,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "já está quase correndo.",
   "start": 22.468,
   "end": 23.95,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "O mais curioso é que talvez aquela pessoa só esteja indo para casa.",
   "start": 23.95,
   "end": 28.15,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Mesmo assim,",
   "start": 28.15,
   "end": 28.706,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "seu corpo começa a agir como se existisse algum perigo.",
   "start": 28.706,
   "end": 31.95,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "E isso tem uma explicação interessante:",
   "start": 31.95,
   "end": 34.15,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "seu cérebro não precisa ter certeza de que existe uma ameaça para começar a se preparar para ela.",
   "start": 34.15,
   "end": 39.636,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "Quando você percebe alguém se aproximando por trás,",
   "start": 39.636,
   "end": 42.15,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "não consegue ver o rosto da pessoa,",
   "start": 42.15,
   "end": 44.043,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "não sabe qual é a intenção dela e nem consegue acompanhar seus movimentos com facilidade.",
   "start": 44.043,
   "end": 49.1,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Essa falta de informação faz sua mente tentar preencher as lacunas.",
   "start": 49.1,
   "end": 52.873,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "E,",
   "start": 52.873,
   "end": 53.036,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "quando existe a possibilidade de perigo,",
   "start": 53.036,
   "end": 55.685,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "ela tende a prestar muito mais atenção aos sinais que poderiam confirmar essa suspeita.",
   "start": 55.685,
   "end": 59.86,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "É por isso que qualquer detalhe começa a parecer importante.",
   "start": 59.86,
   "end": 62.995,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Se os passos ficam mais próximos,",
   "start": 62.995,
   "end": 64.599,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "você pensa que a pessoa está seguindo você.",
   "start": 64.599,
   "end": 66.93,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "Se ela diminui o ritmo,",
   "start": 66.93,
   "end": 68.536,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "você desconfia que está esperando alguma coisa.",
   "start": 68.536,
   "end": 71.0,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Até o simples barulho de uma sacola pode fazer você olhar para trás.",
   "start": 71.0,
   "end": 74.588,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "Mas existe um detalhe ainda mais curioso:",
   "start": 74.588,
   "end": 77.016,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "depois que você acelera,",
   "start": 77.016,
   "end": 78.525,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "começa a prestar atenção em cada movimento da pessoa.",
   "start": 78.525,
   "end": 81.444,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "E,",
   "start": 81.444,
   "end": 81.765,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "se ela também acelerar,",
   "start": 81.765,
   "end": 83.016,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "isso pode parecer uma confirmação de que você estava certo.",
   "start": 83.016,
   "end": 86.295,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Só que talvez ela tenha percebido que você estava andando mais rápido e simplesmente tenha feito o mesmo para não ficar para trás.",
   "start": 86.295,
   "end": 93.0,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "Os dois acabam reagindo um ao outro sem saber o que está acontecendo.",
   "start": 93.0,
   "end": 96.988,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "E tem uma coisa que quase todo mundo já fez:",
   "start": 96.988,
   "end": 99.566,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "fingir que recebeu uma mensagem só para olhar a tela do celular e conseguir observar quem está vindo atrás.",
   "start": 99.566,
   "end": 105.691,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "No fundo,",
   "start": 105.691,
   "end": 106.153,
   "anchored_on_pause": false
  },
  {
   "i": 44,
   "text": "você está tentando descobrir se existe algum motivo para ter medo antes mesmo de saber quem está ali.",
   "start": 106.153,
   "end": 112.002,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "E a próxima vez que isso acontecer,",
   "start": 112.002,
   "end": 114.221,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "repare:",
   "start": 114.221,
   "end": 114.71,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "será que a pessoa realmente está seguindo você ou será que vocês dois estão apenas tentando chegar ao mesmo lugar?",
   "start": 114.71,
   "end": 121.32,
   "anchored_on_pause": null
  }
 ],
