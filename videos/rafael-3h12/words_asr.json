 "segments": [
  {
   "i": 0,
   "text": "Se você costuma ficar acordado quando todo mundo já está dormindo,",
   "start": -1.403,
   "end": 2.953,
   "anchored_on_pause": false
  },
  {
   "i": 1,
   "text": "preste atenção.",
   "start": 2.953,
   "end": 3.709,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Porque o que aconteceu com Rafael naquela madrugada fez ele nunca mais querer ficar sozinho depois das três da manhã.",
   "start": 3.709,
   "end": 9.219,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "Rafael tinha 27 anos e trabalhava de casa.",
   "start": 9.219,
   "end": 11.923,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Por isso,",
   "start": 11.923,
   "end": 12.303,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "costumava dormir muito tarde.",
   "start": 12.303,
   "end": 13.57,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "Naquela noite,",
   "start": 13.57,
   "end": 14.288,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "eram exatamente 3h12 quando ouviu três batidas na porta do apartamento.",
   "start": 14.288,
   "end": 18.169,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Achou estranho,",
   "start": 18.169,
   "end": 18.798,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "porque morava sozinho e não esperava ninguém.",
   "start": 18.798,
   "end": 21.0,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "Olhou pelo olho mágico,",
   "start": 21.0,
   "end": 22.166,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "mas não havia absolutamente ninguém no corredor.",
   "start": 22.166,
   "end": 24.403,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Voltou para o computador,",
   "start": 24.403,
   "end": 25.597,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "tentando esquecer aquilo,",
   "start": 25.597,
   "end": 26.934,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "até receber uma mensagem de um número desconhecido:",
   "start": 26.934,
   "end": 29.597,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "\"Não olhe pela janela.\"",
   "start": 29.597,
   "end": 30.818,
   "anchored_on_pause": false
  },
  {
   "i": 16,
   "text": "Rafael achou que fosse uma brincadeira.",
   "start": 30.818,
   "end": 32.706,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Porém,",
   "start": 32.706,
   "end": 32.984,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "antes que pudesse responder,",
   "start": 32.984,
   "end": 34.296,
   "anchored_on_pause": false
  },
  {
   "i": 19,
   "text": "outra mensagem chegou:",
   "start": 34.296,
   "end": 35.264,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "\"Ele percebeu que você está acordado.\"",
   "start": 35.264,
   "end": 37.365,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "Nesse instante,",
   "start": 37.365,
   "end": 38.255,
   "anchored_on_pause": false
  },
  {
   "i": 22,
   "text": "ouviu um barulho vindo da cozinha.",
   "start": 38.255,
   "end": 40.209,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Pegou o celular e acendeu a lanterna.",
   "start": 40.209,
   "end": 42.09,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "Tudo parecia normal,",
   "start": 42.09,
   "end": 43.076,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "mas havia um detalhe impossível:",
   "start": 43.076,
   "end": 44.15,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "a janela estava aberta.",
   "start": 44.15,
   "end": 45.575,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "Rafael tinha certeza de que a havia trancado antes de dormir.",
   "start": 45.575,
   "end": 48.593,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Quando se aproximou,",
   "start": 48.593,
   "end": 49.543,
   "anchored_on_pause": false
  },
  {
   "i": 29,
   "text": "viu uma marca de mão no vidro,",
   "start": 49.543,
   "end": 51.063,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "do lado de dentro.",
   "start": 51.063,
   "end": 51.937,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Seu coração disparou.",
   "start": 51.937,
   "end": 53.063,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Então,",
   "start": 53.063,
   "end": 53.443,
   "anchored_on_pause": false
  },
  {
   "i": 33,
   "text": "o celular vibrou novamente.",
   "start": 53.443,
   "end": 54.876,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Era uma foto da sala dele,",
   "start": 54.876,
   "end": 56.428,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "tirada de um ângulo que parecia mostrar alguém escondido atrás do sofá.",
   "start": 56.428,
   "end": 59.904,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Rafael olhou imediatamente para trás.",
   "start": 59.904,
   "end": 61.778,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Não havia ninguém.",
   "start": 61.778,
   "end": 62.377,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "Desesperado,",
   "start": 62.377,
   "end": 62.9,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "ligou para a polícia.",
   "start": 62.9,
   "end": 64.289,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "Enquanto aguardava,",
   "start": 64.289,
   "end": 65.215,
   "anchored_on_pause": false
  },
  {
   "i": 41,
   "text": "ouviu sua própria voz vindo do quarto,",
   "start": 65.215,
   "end": 66.8,
   "anchored_on_pause": false
  },
  {
   "i": 42,
   "text": "dizendo:",
   "start": 66.8,
   "end": 67.262,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "\"Rafael,",
   "start": 67.262,
   "end": 67.705,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "pode entrar.",
   "start": 67.705,
   "end": 68.223,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "Já está tudo bem.\"",
   "start": 68.223,
   "end": 69.016,
   "anchored_on_pause": false
  },
  {
   "i": 46,
   "text": "Mas ele estava na sala.",
   "start": 69.016,
   "end": 70.557,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "A porta do quarto começou a se abrir lentamente.",
   "start": 70.557,
   "end": 72.859,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "Nesse momento,",
   "start": 72.859,
   "end": 73.478,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "chegou a última mensagem:",
   "start": 73.478,
   "end": 74.764,
   "anchored_on_pause": false
  },
  {
   "i": 50,
   "text": "\"Não entre.",
   "start": 74.764,
   "end": 75.307,
   "anchored_on_pause": true
  },
  {
   "i": 51,
   "text": "Eu estou tentando manter ele aí dentro.\"",
   "start": 75.307,
   "end": 77.138,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Rafael ficou paralisado.",
   "start": 77.138,
   "end": 78.752,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "Se alguém estava mandando aquelas mensagens,",
   "start": 78.752,
   "end": 80.611,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "quem estava falando dentro do quarto?",
   "start": 80.611,
   "end": 82.392,
   "anchored_on_pause": false
  },
  {
   "i": 55,
   "text": "E então,",
   "start": 82.392,
   "end": 82.922,
   "anchored_on_pause": false
  },
  {
   "i": 56,
   "text": "do fundo do corredor,",
   "start": 82.922,
   "end": 83.957,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "alguém respondeu com a voz dele:",
   "start": 83.957,
   "end": 85.348,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "\"Você demorou para perceber.\"",
   "start": 85.348,
   "end": 86.801,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "Agora me diga:",
   "start": 86.801,
   "end": 87.597,
   "anchored_on_pause": false
  },
  {
   "i": 60,
   "text": "você entraria no quarto para descobrir quem está lá ou sairia do apartamento imediatamente?",
   "start": 87.597,
   "end": 92.15,
   "anchored_on_pause": false
  },
  {
   "i": 61,
   "text": "Comente o que Rafael deveria fazer.",
   "start": 92.15,
   "end": 94.21,
   "anchored_on_pause": null
  }
 ],
