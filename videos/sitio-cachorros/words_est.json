 ],
 "segments": [
  {
   "i": 0,
   "text": "Se os cachorros da roça pararem de latir todos de uma vez,",
   "start": 0.0,
   "end": 3.04,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "apague a luz e não chegue perto da janela.",
   "start": 3.37,
   "end": 5.54,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "Caio nunca levou muito a sério essa história,",
   "start": 5.85,
   "end": 7.56,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "até passar uma noite no sítio do avô,",
   "start": 7.99,
   "end": 9.94,
   "anchored_on_pause": false
  },
  {
   "i": 4,
   "text": "no sul de Minas Gerais.",
   "start": 9.94,
   "end": 11.52,
   "anchored_on_pause": true
  },
  {
   "i": 5,
   "text": "Era sexta-feira,",
   "start": 11.66,
   "end": 12.58,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "noite de lua cheia,",
   "start": 12.58,
   "end": 13.0,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "e o relógio estava prestes a marcar meia-noite.",
   "start": 13.32,
   "end": 15.479,
   "anchored_on_pause": false
  },
  {
   "i": 8,
   "text": "Antes de dormir,",
   "start": 15.479,
   "end": 16.04,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "seu avô Antônio contou uma coisa que sempre escondia dos visitantes:",
   "start": 16.42,
   "end": 19.45,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "o vizinho era o sétimo filho homem de uma família,",
   "start": 19.6,
   "end": 22.404,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "e,",
   "start": 22.404,
   "end": 22.606,
   "anchored_on_pause": false
  },
  {
   "i": 12,
   "text": "segundo uma antiga lenda da região,",
   "start": 22.606,
   "end": 24.32,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "todo sétimo filho precisava passar certas noites longe de casa.",
   "start": 24.65,
   "end": 27.94,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "Principalmente quando a lua estava cheia.",
   "start": 28.06,
   "end": 29.71,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Caio achou aquilo uma bobagem,",
   "start": 29.92,
   "end": 31.16,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "até ouvir os quatro cachorros começarem a latir desesperadamente em direção ao pasto.",
   "start": 31.69,
   "end": 36.0,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Os animais estavam tão agitados que chegavam a puxar as correntes.",
   "start": 36.29,
   "end": 39.282,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "Mas,",
   "start": 39.282,
   "end": 39.484,
   "anchored_on_pause": false
  },
  {
   "i": 19,
   "text": "de repente,",
   "start": 39.484,
   "end": 40.064,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "os quatro ficaram em silêncio ao mesmo tempo.",
   "start": 40.064,
   "end": 42.23,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "Nem um rosnado.",
   "start": 42.62,
   "end": 43.251,
   "anchored_on_pause": false
  },
  {
   "i": 22,
   "text": "Nem um movimento.",
   "start": 43.251,
   "end": 44.21,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Seu avô parou de mexer no fogão,",
   "start": 44.33,
   "end": 45.79,
   "anchored_on_pause": false
  },
  {
   "i": 24,
   "text": "apagou o lampião e segurou o braço do neto.",
   "start": 45.79,
   "end": 47.98,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "\"Escuta bem.",
   "start": 48.26,
   "end": 48.68,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "Não importa o que você ouvir,",
   "start": 48.82,
   "end": 50.129,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "não abra a porta e não olhe pela janela.",
   "start": 50.129,
   "end": 52.12,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Eu volto já.\"",
   "start": 52.27,
   "end": 52.957,
   "anchored_on_pause": false
  },
  {
   "i": 29,
   "text": "Antes que Caio pudesse perguntar qualquer coisa,",
   "start": 52.957,
   "end": 54.87,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "o velho desapareceu pela porta dos fundos.",
   "start": 55.22,
   "end": 57.07,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "A casa ficou completamente escura.",
   "start": 57.27,
   "end": 58.82,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Alguns minutos depois,",
   "start": 58.95,
   "end": 60.113,
   "anchored_on_pause": false
  },
  {
   "i": 33,
   "text": "ele ouviu passos pesados na varanda.",
   "start": 60.113,
   "end": 61.82,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Não pareciam passos humanos.",
   "start": 62.07,
   "end": 63.31,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "Alguma coisa arrastava as patas pelo chão,",
   "start": 63.46,
   "end": 65.44,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "dando a volta na casa e farejando cada fresta da madeira.",
   "start": 65.58,
   "end": 68.57,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Caio tentou se convencer de que era apenas um animal perdido,",
   "start": 68.76,
   "end": 71.14,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "até ouvir três batidas na janela.",
   "start": 71.68,
   "end": 73.23,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Então veio uma voz conhecida:",
   "start": 73.4,
   "end": 74.71,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "\"Caio,",
   "start": 74.87,
   "end": 75.129,
   "anchored_on_pause": false
  },
  {
   "i": 41,
   "text": "abre aqui.",
   "start": 75.129,
   "end": 75.65,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Sou eu,",
   "start": 75.79,
   "end": 76.176,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "seu avô.\"",
   "start": 76.176,
   "end": 76.63,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "Ele quase se levantou,",
   "start": 76.75,
   "end": 77.833,
   "anchored_on_pause": false
  },
  {
   "i": 45,
   "text": "mas lembrou do aviso.",
   "start": 77.833,
   "end": 78.87,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "Ficou imóvel.",
   "start": 78.99,
   "end": 79.56,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "A voz chamou novamente,",
   "start": 79.72,
   "end": 80.73,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "dessa vez mais baixa:",
   "start": 81.11,
   "end": 81.572,
   "anchored_on_pause": false
  },
  {
   "i": 49,
   "text": "\"Abre,",
   "start": 81.572,
   "end": 81.88,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "menino.",
   "start": 82.0,
   "end": 82.473,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "Está frio aqui fora.\"",
   "start": 82.473,
   "end": 83.6,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "Foi quando outra mão agarrou seu braço por trás.",
   "start": 83.72,
   "end": 85.93,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "Caio quase gritou,",
   "start": 86.34,
   "end": 87.18,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "mas ouviu um sussurro junto ao ouvido:",
   "start": 87.52,
   "end": 89.16,
   "anchored_on_pause": true
  },
  {
   "i": 55,
   "text": "\"Não responde.",
   "start": 89.3,
   "end": 89.87,
   "anchored_on_pause": true
  },
  {
   "i": 56,
   "text": "Eu ainda não voltei.\"",
   "start": 90.07,
   "end": 90.7,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "Era a voz do avô.",
   "start": 90.87,
   "end": 91.64,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "Caio passou o resto da noite imóvel,",
   "start": 91.82,
   "end": 93.49,
   "anchored_on_pause": true
  },
  {
   "i": 59,
   "text": "sentindo aquela coisa caminhar ao redor da casa e parar repetidamente diante da janela.",
   "start": 93.85,
   "end": 98.38,
   "anchored_on_pause": true
  },
  {
   "i": 60,
   "text": "Só quando o galo cantou os passos desapareceram.",
   "start": 98.64,
   "end": 101.5,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Ao amanhecer,",
   "start": 101.82,
   "end": 102.563,
   "anchored_on_pause": false
  },
  {
   "i": 62,
   "text": "Antônio entrou pela cozinha,",
   "start": 102.563,
   "end": 103.91,
   "anchored_on_pause": true
  },
  {
   "i": 63,
   "text": "coberto de palha e terra.",
   "start": 104.03,
   "end": 105.16,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "Disse que tinha passado a noite escondido no paiol,",
   "start": 105.52,
   "end": 107.71,
   "anchored_on_pause": true
  },
  {
   "i": 65,
   "text": "sem coragem de voltar.",
   "start": 107.89,
   "end": 108.91,
   "anchored_on_pause": true
  },
  {
   "i": 66,
   "text": "Caio mostrou o braço.",
   "start": 109.37,
   "end": 110.52,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "Havia cinco marcas profundas,",
   "start": 110.67,
   "end": 112.43,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "como se dedos compridos tivessem apertado sua pele.",
   "start": 112.57,
   "end": 115.75,
   "anchored_on_pause": true
  },
  {
   "i": 69,
   "text": "O avô ficou pálido.",
   "start": 116.12,
   "end": 116.97,
   "anchored_on_pause": true
  },
  {
   "i": 70,
   "text": "Então revelou que,",
   "start": 117.19,
   "end": 118.11,
   "anchored_on_pause": false
  },
  {
   "i": 71,
   "text": "durante a madrugada,",
   "start": 118.11,
   "end": 119.194,
   "anchored_on_pause": false
  },
  {
   "i": 72,
   "text": "ouviu alguém chamando por ele dentro do paiol.",
   "start": 119.194,
   "end": 121.12,
   "anchored_on_pause": true
  },
  {
   "i": 73,
   "text": "E a voz vinha debaixo do milho.",
   "start": 121.26,
   "end": 122.93,
   "anchored_on_pause": true
  },
  {
   "i": 74,
   "text": "Se os cachorros parassem de latir hoje à noite,",
   "start": 123.38,
   "end": 125.47,
   "anchored_on_pause": true
  },
  {
   "i": 75,
   "text": "você ficaria no quarto ou correria para o paiol?",
   "start": 125.62,
   "end": 127.87,
   "anchored_on_pause": true
  },
  {
   "i": 76,
   "text": "Comenta aí,",
   "start": 128.15,
   "end": 128.714,
   "anchored_on_pause": false
  },
  {
   "i": 77,
   "text": "porque existe um detalhe dessa história que o avô de Caio nunca teve coragem de contar.",
   "start": 128.714,
   "end": 133.07,
   "anchored_on_pause": null
  }
 ],
