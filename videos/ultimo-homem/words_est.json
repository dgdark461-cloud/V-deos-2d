 ],
 "segments": [
  {
   "i": 0,
   "text": "Imagine acordar e descobrir que a humanidade inteira desapareceu durante a madrugada.",
   "start": 0.0,
   "end": 4.5,
   "anchored_on_pause": false
  },
  {
   "i": 1,
   "text": "Nenhuma pessoa nas ruas,",
   "start": 4.5,
   "end": 5.75,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "nenhum avião no céu,",
   "start": 5.95,
   "end": 7.04,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "nenhuma voz nos telefones.",
   "start": 7.48,
   "end": 8.79,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Agora imagine passar um ano completamente sozinho e,",
   "start": 9.1,
   "end": 12.64,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "justamente quando você aceita que nunca mais verá outro ser humano,",
   "start": 12.64,
   "end": 15.32,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "descobrir que talvez não esteja tão sozinho quanto imaginava.",
   "start": 15.74,
   "end": 18.99,
   "anchored_on_pause": true
  },
  {
   "i": 7,
   "text": "Foi isso que aconteceu com Daniel.",
   "start": 19.31,
   "end": 20.46,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Naquela manhã,",
   "start": 20.83,
   "end": 21.432,
   "anchored_on_pause": false
  },
  {
   "i": 9,
   "text": "ele acordou,",
   "start": 21.432,
   "end": 22.175,
   "anchored_on_pause": false
  },
  {
   "i": 10,
   "text": "preparou café e saiu para trabalhar,",
   "start": 22.175,
   "end": 23.988,
   "anchored_on_pause": false
  },
  {
   "i": 11,
   "text": "mas percebeu algo estranho:",
   "start": 23.988,
   "end": 25.47,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "todos os carros estavam parados,",
   "start": 25.71,
   "end": 27.22,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "os semáforos continuavam funcionando e não havia uma única pessoa nas ruas.",
   "start": 27.37,
   "end": 31.4,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "No hospital,",
   "start": 31.54,
   "end": 32.05,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "encontrou corredores vazios,",
   "start": 32.49,
   "end": 33.82,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "computadores ligados e refeições ainda sobre as mesas.",
   "start": 34.02,
   "end": 37.04,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Não existiam corpos,",
   "start": 37.2,
   "end": 38.285,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "sinais de luta ou explicações.",
   "start": 38.285,
   "end": 40.22,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Todos simplesmente desapareceram.",
   "start": 40.36,
   "end": 41.92,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "Desesperado,",
   "start": 42.5,
   "end": 42.961,
   "anchored_on_pause": false
  },
  {
   "i": 21,
   "text": "tentou ligar para sua família,",
   "start": 42.961,
   "end": 44.36,
   "anchored_on_pause": true
  },
  {
   "i": 22,
   "text": "mas todas as chamadas caíam na caixa postal.",
   "start": 44.55,
   "end": 46.52,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Então percebeu que as últimas atividades dos contatos terminavam exatamente às 2h47 da madrugada.",
   "start": 46.66,
   "end": 52.38,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "Daniel estava sozinho.",
   "start": 52.55,
   "end": 53.245,
   "anchored_on_pause": false
  },
  {
   "i": 25,
   "text": "E,",
   "start": 53.245,
   "end": 53.37,
   "anchored_on_pause": true
  },
  {
   "i": 26,
   "text": "se quisesse sobreviver,",
   "start": 53.78,
   "end": 54.759,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "precisaria seguir algumas regras.",
   "start": 54.759,
   "end": 56.23,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Primeira:",
   "start": 56.38,
   "end": 56.82,
   "anchored_on_pause": true
  },
  {
   "i": 29,
   "text": "aproveite tudo enquanto ainda funciona.",
   "start": 57.26,
   "end": 59.054,
   "anchored_on_pause": false
  },
  {
   "i": 30,
   "text": "Sem funcionários nas usinas,",
   "start": 59.054,
   "end": 60.329,
   "anchored_on_pause": false
  },
  {
   "i": 31,
   "text": "a energia poderia acabar a qualquer momento.",
   "start": 60.329,
   "end": 62.72,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Ele começou a armazenar alimentos,",
   "start": 63.05,
   "end": 64.65,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "água,",
   "start": 64.79,
   "end": 65.285,
   "anchored_on_pause": false
  },
  {
   "i": 34,
   "text": "medicamentos e combustível,",
   "start": 65.285,
   "end": 66.8,
   "anchored_on_pause": true
  },
  {
   "i": 35,
   "text": "antes que geladeiras parassem e os produtos estragassem.",
   "start": 67.0,
   "end": 69.97,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Segunda:",
   "start": 70.11,
   "end": 70.48,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "nunca dependa de um único lugar.",
   "start": 70.88,
   "end": 72.684,
   "anchored_on_pause": false
  },
  {
   "i": 38,
   "text": "Daniel percebeu que prédios,",
   "start": 72.684,
   "end": 74.075,
   "anchored_on_pause": false
  },
  {
   "i": 39,
   "text": "mercados e hospitais poderiam se tornar armadilhas quando faltassem manutenção e segurança.",
   "start": 74.075,
   "end": 78.752,
   "anchored_on_pause": false
  },
  {
   "i": 40,
   "text": "Por isso,",
   "start": 78.752,
   "end": 79.21,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "escolheu uma casa próxima a um rio e organizou suprimentos para sobreviver durante anos.",
   "start": 79.54,
   "end": 83.5,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Terceira:",
   "start": 83.65,
   "end": 84.148,
   "anchored_on_pause": false
  },
  {
   "i": 43,
   "text": "não permita que sua mente desista antes do seu corpo.",
   "start": 84.148,
   "end": 86.62,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "Sem conversar com ninguém,",
   "start": 87.02,
   "end": 88.04,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "começou a esquecer até o som da própria voz.",
   "start": 88.29,
   "end": 90.346,
   "anchored_on_pause": false
  },
  {
   "i": 46,
   "text": "Passou a gravar mensagens,",
   "start": 90.346,
   "end": 91.7,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "contar histórias e conversar com fotografias,",
   "start": 91.84,
   "end": 93.565,
   "anchored_on_pause": false
  },
  {
   "i": 48,
   "text": "apenas para não enlouquecer.",
   "start": 93.565,
   "end": 95.19,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "Quarta:",
   "start": 95.44,
   "end": 95.75,
   "anchored_on_pause": true
  },
  {
   "i": 50,
   "text": "procure sinais de sobreviventes,",
   "start": 96.03,
   "end": 97.65,
   "anchored_on_pause": true
  },
  {
   "i": 51,
   "text": "mas nunca confie imediatamente no que encontrar.",
   "start": 97.78,
   "end": 100.353,
   "anchored_on_pause": false
  },
  {
   "i": 52,
   "text": "Todos os dias,",
   "start": 100.353,
   "end": 100.97,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "ao meio-dia,",
   "start": 101.17,
   "end": 101.774,
   "anchored_on_pause": false
  },
  {
   "i": 54,
   "text": "transmitia uma mensagem pelo rádio:",
   "start": 101.774,
   "end": 103.41,
   "anchored_on_pause": true
  },
  {
   "i": 55,
   "text": "\"Meu nome é Daniel.",
   "start": 103.53,
   "end": 104.45,
   "anchored_on_pause": true
  },
  {
   "i": 56,
   "text": "Estou vivo.",
   "start": 104.64,
   "end": 105.11,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "Se alguém estiver ouvindo,",
   "start": 105.31,
   "end": 106.74,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "responda.\"",
   "start": 107.05,
   "end": 107.645,
   "anchored_on_pause": false
  },
  {
   "i": 59,
   "text": "Durante 365 dias,",
   "start": 107.645,
   "end": 109.02,
   "anchored_on_pause": true
  },
  {
   "i": 60,
   "text": "não recebeu absolutamente nada.",
   "start": 109.3,
   "end": 110.88,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Até que,",
   "start": 111.13,
   "end": 111.52,
   "anchored_on_pause": true
  },
  {
   "i": 62,
   "text": "numa noite,",
   "start": 111.68,
   "end": 112.253,
   "anchored_on_pause": false
  },
  {
   "i": 63,
   "text": "enquanto observava a cidade do alto de um prédio,",
   "start": 112.253,
   "end": 114.34,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "viu uma luz piscando do outro lado do rio.",
   "start": 114.72,
   "end": 116.74,
   "anchored_on_pause": true
  },
  {
   "i": 65,
   "text": "Três piscadas curtas,",
   "start": 116.93,
   "end": 117.97,
   "anchored_on_pause": true
  },
  {
   "i": 66,
   "text": "três longas e três curtas.",
   "start": 118.13,
   "end": 119.64,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "SOS.",
   "start": 119.8,
   "end": 120.31,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "Alguém estava vivo!",
   "start": 120.44,
   "end": 121.37,
   "anchored_on_pause": true
  },
  {
   "i": 69,
   "text": "Daniel passou a noite tentando responder com uma lanterna.",
   "start": 121.75,
   "end": 124.09,
   "anchored_on_pause": true
  },
  {
   "i": 70,
   "text": "Na manhã seguinte,",
   "start": 124.42,
   "end": 125.493,
   "anchored_on_pause": false
  },
  {
   "i": 71,
   "text": "voltou ao terraço e encontrou algo impossível:",
   "start": 125.493,
   "end": 127.88,
   "anchored_on_pause": true
  },
  {
   "i": 72,
   "text": "uma frase escrita no chão,",
   "start": 128.04,
   "end": 129.396,
   "anchored_on_pause": false
  },
  {
   "i": 73,
   "text": "com tinta fresca,",
   "start": 129.396,
   "end": 130.12,
   "anchored_on_pause": true
  },
  {
   "i": 74,
   "text": "ao lado de sua mensagem:",
   "start": 130.44,
   "end": 131.484,
   "anchored_on_pause": false
  },
  {
   "i": 75,
   "text": "\"PARE DE PROCURAR.",
   "start": 131.484,
   "end": 132.43,
   "anchored_on_pause": true
  },
  {
   "i": 76,
   "text": "VOCÊ NÃO ESTÁ SOZINHO.\"",
   "start": 132.6,
   "end": 133.74,
   "anchored_on_pause": true
  },
  {
   "i": 77,
   "text": "Ele correu até a escada,",
   "start": 133.92,
   "end": 134.97,
   "anchored_on_pause": true
  },
  {
   "i": 78,
   "text": "desceu vários andares e encontrou a porta do próprio apartamento aberta.",
   "start": 135.29,
   "end": 138.92,
   "anchored_on_pause": true
  },
  {
   "i": 79,
   "text": "Sobre a mesa havia uma xícara de café quente e um bilhete:",
   "start": 139.08,
   "end": 142.689,
   "anchored_on_pause": false
  },
  {
   "i": 80,
   "text": "\"Daniel,",
   "start": 142.689,
   "end": 143.03,
   "anchored_on_pause": true
  },
  {
   "i": 81,
   "text": "amanhã,",
   "start": 143.15,
   "end": 143.882,
   "anchored_on_pause": false
  },
  {
   "i": 82,
   "text": "às 2h47,",
   "start": 143.882,
   "end": 144.3,
   "anchored_on_pause": true
  },
  {
   "i": 83,
   "text": "você vai entender por que todos desapareceram.\"",
   "start": 144.61,
   "end": 146.74,
   "anchored_on_pause": null
  }
 ],
