 ],
 "segments": [
  {
   "i": 0,
   "text": "Você acorda,",
   "start": 0.0,
   "end": 0.75,
   "anchored_on_pause": false
  },
  {
   "i": 1,
   "text": "pega o celular e descobre uma coisa impossível:",
   "start": 0.75,
   "end": 3.35,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "oito bilhões de pessoas desapareceram.",
   "start": 3.47,
   "end": 5.18,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "Só você ficou.",
   "start": 5.32,
   "end": 6.29,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Mas o verdadeiro pesadelo começa quando alguém bate à sua porta.",
   "start": 6.43,
   "end": 9.9,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "Arthur ainda não sabia disso.",
   "start": 9.9,
   "end": 11.65,
   "anchored_on_pause": false
  },
  {
   "i": 6,
   "text": "Naquela segunda-feira,",
   "start": 11.65,
   "end": 12.9,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "saiu atrasado,",
   "start": 12.9,
   "end": 13.97,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "mordendo um sanduíche,",
   "start": 14.1,
   "end": 15.13,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "rumo ao metrô.",
   "start": 15.28,
   "end": 15.9,
   "anchored_on_pause": true
  },
  {
   "i": 10,
   "text": "Até perceber o silêncio.",
   "start": 16.23,
   "end": 17.07,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "Nenhum carro.",
   "start": 17.2,
   "end": 17.77,
   "anchored_on_pause": true
  },
  {
   "i": 12,
   "text": "Nenhuma conversa.",
   "start": 17.9,
   "end": 18.42,
   "anchored_on_pause": true
  },
  {
   "i": 13,
   "text": "Nem um único passo além dos seus.",
   "start": 18.59,
   "end": 20.363,
   "anchored_on_pause": false
  },
  {
   "i": 14,
   "text": "Ele ergueu os olhos.",
   "start": 20.363,
   "end": 21.366,
   "anchored_on_pause": false
  },
  {
   "i": 15,
   "text": "A cidade inteira estava vazia.",
   "start": 21.366,
   "end": 23.0,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "Correu para a estação.",
   "start": 23.16,
   "end": 24.53,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Escadas rolantes funcionando.",
   "start": 24.94,
   "end": 26.018,
   "anchored_on_pause": false
  },
  {
   "i": 18,
   "text": "Trem parado,",
   "start": 26.018,
   "end": 26.79,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "portas abertas.",
   "start": 26.98,
   "end": 27.805,
   "anchored_on_pause": false
  },
  {
   "i": 20,
   "text": "Nenhum passageiro.",
   "start": 27.805,
   "end": 29.16,
   "anchored_on_pause": true
  },
  {
   "i": 21,
   "text": "Nenhum corpo.",
   "start": 29.39,
   "end": 29.764,
   "anchored_on_pause": false
  },
  {
   "i": 22,
   "text": "Nenhuma explicação.",
   "start": 29.764,
   "end": 30.86,
   "anchored_on_pause": true
  },
  {
   "i": 23,
   "text": "Desesperado,",
   "start": 30.98,
   "end": 31.6,
   "anchored_on_pause": true
  },
  {
   "i": 24,
   "text": "ligou para a mãe,",
   "start": 31.72,
   "end": 32.67,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "o pai,",
   "start": 32.86,
   "end": 33.416,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "os amigos.",
   "start": 33.416,
   "end": 34.274,
   "anchored_on_pause": false
  },
  {
   "i": 27,
   "text": "Ninguém respondeu.",
   "start": 34.274,
   "end": 35.23,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "Então viu algo perturbador:",
   "start": 35.37,
   "end": 37.053,
   "anchored_on_pause": false
  },
  {
   "i": 29,
   "text": "todos apareciam online pela última vez exatamente às 3h12.",
   "start": 37.053,
   "end": 40.56,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "O que aconteceu naquele minuto?",
   "start": 40.72,
   "end": 42.141,
   "anchored_on_pause": false
  },
  {
   "i": 31,
   "text": "Arthur procurou sobreviventes durante dias.",
   "start": 42.141,
   "end": 44.01,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Nada.",
   "start": 44.19,
   "end": 44.43,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "E logo descobriu que estar sozinho era apenas o primeiro perigo.",
   "start": 44.56,
   "end": 47.55,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Sem funcionários nas usinas,",
   "start": 47.96,
   "end": 49.029,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "a eletricidade começou a falhar.",
   "start": 49.029,
   "end": 50.575,
   "anchored_on_pause": false
  },
  {
   "i": 36,
   "text": "Bairros apagaram.",
   "start": 50.575,
   "end": 51.39,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Depois,",
   "start": 51.52,
   "end": 51.9,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "cidades inteiras.",
   "start": 52.02,
   "end": 52.9,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "Ele correu para reunir água,",
   "start": 53.35,
   "end": 54.56,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "comida,",
   "start": 54.74,
   "end": 55.22,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "remédios e combustível antes que tudo estragasse.",
   "start": 55.34,
   "end": 57.861,
   "anchored_on_pause": false
  },
  {
   "i": 42,
   "text": "Mas havia um inimigo que nenhuma reserva conseguiria vencer:",
   "start": 57.861,
   "end": 60.92,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "o silêncio.",
   "start": 61.06,
   "end": 61.711,
   "anchored_on_pause": false
  },
  {
   "i": 44,
   "text": "Arthur passou a conversar com fotografias.",
   "start": 61.711,
   "end": 63.41,
   "anchored_on_pause": true
  },
  {
   "i": 45,
   "text": "Depois,",
   "start": 63.54,
   "end": 63.98,
   "anchored_on_pause": false
  },
  {
   "i": 46,
   "text": "com um manequim.",
   "start": 63.98,
   "end": 64.62,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "Até começar a responder às próprias perguntas.",
   "start": 64.78,
   "end": 66.44,
   "anchored_on_pause": false
  },
  {
   "i": 48,
   "text": "Para não enlouquecer,",
   "start": 66.44,
   "end": 67.7,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "criou um ritual.",
   "start": 67.9,
   "end": 68.633,
   "anchored_on_pause": false
  },
  {
   "i": 50,
   "text": "Todo meio-dia,",
   "start": 68.633,
   "end": 69.24,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "transmitia pelo rádio:",
   "start": 69.24,
   "end": 70.494,
   "anchored_on_pause": false
  },
  {
   "i": 52,
   "text": "\"Meu nome é Arthur.",
   "start": 70.494,
   "end": 71.34,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "Estou vivo.",
   "start": 71.56,
   "end": 72.11,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "Alguém consegue me ouvir?\"",
   "start": 72.24,
   "end": 73.209,
   "anchored_on_pause": false
  },
  {
   "i": 55,
   "text": "No terraço,",
   "start": 73.209,
   "end": 73.816,
   "anchored_on_pause": false
  },
  {
   "i": 56,
   "text": "pintou uma palavra gigantesca:",
   "start": 73.816,
   "end": 75.28,
   "anchored_on_pause": true
  },
  {
   "i": 57,
   "text": "VIVO.",
   "start": 75.41,
   "end": 75.67,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "Passaram cem dias.",
   "start": 75.89,
   "end": 76.781,
   "anchored_on_pause": false
  },
  {
   "i": 59,
   "text": "Duzentos.",
   "start": 76.781,
   "end": 77.44,
   "anchored_on_pause": true
  },
  {
   "i": 60,
   "text": "Um ano inteiro.",
   "start": 77.56,
   "end": 78.18,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Nenhuma resposta.",
   "start": 78.32,
   "end": 79.1,
   "anchored_on_pause": true
  },
  {
   "i": 62,
   "text": "Na última noite,",
   "start": 79.28,
   "end": 80.061,
   "anchored_on_pause": false
  },
  {
   "i": 63,
   "text": "Arthur desligou o rádio definitivamente.",
   "start": 80.061,
   "end": 81.85,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "Subiu ao terraço para olhar,",
   "start": 82.24,
   "end": 83.543,
   "anchored_on_pause": false
  },
  {
   "i": 65,
   "text": "uma última vez,",
   "start": 83.543,
   "end": 84.415,
   "anchored_on_pause": false
  },
  {
   "i": 66,
   "text": "a cidade morta.",
   "start": 84.415,
   "end": 85.15,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "Foi quando enxergou algo impossível.",
   "start": 85.33,
   "end": 87.06,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "Do outro lado do rio,",
   "start": 87.45,
   "end": 88.654,
   "anchored_on_pause": false
  },
  {
   "i": 69,
   "text": "uma janela se iluminou.",
   "start": 88.654,
   "end": 90.3,
   "anchored_on_pause": true
  },
  {
   "i": 70,
   "text": "A luz piscou três vezes rapidamente.",
   "start": 90.44,
   "end": 92.507,
   "anchored_on_pause": false
  },
  {
   "i": 71,
   "text": "Depois,",
   "start": 92.507,
   "end": 92.851,
   "anchored_on_pause": false
  },
  {
   "i": 72,
   "text": "três vezes devagar.",
   "start": 92.851,
   "end": 93.99,
   "anchored_on_pause": true
  },
  {
   "i": 73,
   "text": "E mais três rápidas.",
   "start": 94.14,
   "end": 94.71,
   "anchored_on_pause": true
  },
  {
   "i": 74,
   "text": "SOS.",
   "start": 94.83,
   "end": 95.075,
   "anchored_on_pause": false
  },
  {
   "i": 75,
   "text": "Alguém estava pedindo socorro.",
   "start": 95.075,
   "end": 95.93,
   "anchored_on_pause": true
  },
  {
   "i": 76,
   "text": "Arthur quase chorou.",
   "start": 96.12,
   "end": 96.94,
   "anchored_on_pause": true
  },
  {
   "i": 77,
   "text": "Pela primeira vez em um ano,",
   "start": 97.09,
   "end": 98.218,
   "anchored_on_pause": false
  },
  {
   "i": 78,
   "text": "não estava sozinho.",
   "start": 98.218,
   "end": 99.39,
   "anchored_on_pause": true
  },
  {
   "i": 79,
   "text": "Mas por que aquela pessoa nunca respondeu ao rádio?",
   "start": 99.56,
   "end": 102.23,
   "anchored_on_pause": false
  },
  {
   "i": 80,
   "text": "E por que apareceu justamente naquela noite?",
   "start": 102.23,
   "end": 104.85,
   "anchored_on_pause": true
  },
  {
   "i": 81,
   "text": "Ele decidiu atravessar o rio ao amanhecer.",
   "start": 105.01,
   "end": 107.12,
   "anchored_on_pause": true
  },
  {
   "i": 82,
   "text": "Só que,",
   "start": 107.29,
   "end": 107.63,
   "anchored_on_pause": true
  },
  {
   "i": 83,
   "text": "quando voltou ao terraço,",
   "start": 107.76,
   "end": 109.25,
   "anchored_on_pause": true
  },
  {
   "i": 84,
   "text": "parou imediatamente.",
   "start": 109.38,
   "end": 110.19,
   "anchored_on_pause": true
  },
  {
   "i": 85,
   "text": "Ao lado da palavra VIVO,",
   "start": 110.57,
   "end": 111.93,
   "anchored_on_pause": true
  },
  {
   "i": 86,
   "text": "alguém havia escrito outra mensagem.",
   "start": 112.11,
   "end": 114.367,
   "anchored_on_pause": false
  },
  {
   "i": 87,
   "text": "A tinta ainda estava molhada.",
   "start": 114.367,
   "end": 116.149,
   "anchored_on_pause": false
  },
  {
   "i": 88,
   "text": "Duas palavras:",
   "start": 116.149,
   "end": 117.007,
   "anchored_on_pause": false
  },
  {
   "i": 89,
   "text": "EU TAMBÉM.",
   "start": 117.007,
   "end": 117.74,
   "anchored_on_pause": true
  },
  {
   "i": 90,
   "text": "Ele correu até a porta do terraço.",
   "start": 117.92,
   "end": 119.458,
   "anchored_on_pause": false
  },
  {
   "i": 91,
   "text": "Estava entreaberta.",
   "start": 119.458,
   "end": 120.2,
   "anchored_on_pause": true
  },
  {
   "i": 92,
   "text": "Na maçaneta,",
   "start": 120.35,
   "end": 120.96,
   "anchored_on_pause": true
  },
  {
   "i": 93,
   "text": "uma marca recente de mão que não era sua.",
   "start": 121.32,
   "end": 123.655,
   "anchored_on_pause": false
  },
  {
   "i": 94,
   "text": "Arthur olhou para o prédio distante.",
   "start": 123.655,
   "end": 125.319,
   "anchored_on_pause": false
  },
  {
   "i": 95,
   "text": "A janela continuava acesa.",
   "start": 125.319,
   "end": 127.0,
   "anchored_on_pause": true
  },
  {
   "i": 96,
   "text": "Então percebeu o detalhe mais aterrorizante de todos:",
   "start": 127.15,
   "end": 130.01,
   "anchored_on_pause": true
  },
  {
   "i": 97,
   "text": "aquela mensagem tinha sido escrita enquanto ele dormia.",
   "start": 130.25,
   "end": 132.93,
   "anchored_on_pause": true
  },
  {
   "i": 98,
   "text": "Se o sobrevivente estava do outro lado do rio...",
