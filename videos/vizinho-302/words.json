 {"start": 107.41, "end": 107.77}, {"start": 108.83, "end": 109.11}, {"start": 111.07, "end": 111.22}, {"start": 111.44, "end": 111.89}, {"start": 114.92, "end": 115.08}, {"start": 116.38, "end": 116.51}, {"start": 116.53, "end": 116.79}, {"start": 117.28, "end": 117.73}, {"start": 121.45, "end": 121.84}, {"start": 123.09, "end": 123.32}], "segments": [{"i": 0, "text": "O vizinho que nunca sai de casa.", "start": 0, "end": 1.632, "anchored_on_pause": true}, {"i": 1, "text": "Você já teve um vizinho que parecia existir apenas atrás de uma porta?", "start": 1.632, "end": 5.2, "anchored_on_pause": true}, {"i": 2, "text": "No prédio onde Marina morava,", "start": 5.2, "end": 7.016, "anchored_on_pause": true}, {"i": 3, "text": "havia um homem no apartamento 302 que ninguém via.", "start": 7.016, "end": 10.155, "anchored_on_pause": true}, {"i": 4, "text": "Nunca recebia visitas,", "start": 10.155, "end": 11.45, "anchored_on_pause": false}, {"i": 5, "text": "nunca descia para buscar encomendas e,", "start": 11.45, "end": 13.57, "anchored_on_pause": true}, {"i": 6, "text": "segundo o porteiro,", "start": 13.57, "end": 14.756, "anchored_on_pause": false}, {"i": 7, "text": "quase nunca saía.", "start": 14.756, "end": 15.57, "anchored_on_pause": true}, {"i": 8, "text": "Mesmo assim,", "start": 15.57, "end": 16.267, "anchored_on_pause": true}, {"i": 9, "text": "todas as manhãs,", "start": 16.267, "end": 17.081, "anchored_on_pause": false}, {"i": 10, "text": "exatamente às nove horas,", "start": 17.081, "end": 18.829, "anchored_on_pause": true}, {"i": 11, "text": "a luz da sala dele acendia e apagava três vezes.", "start": 18.829, "end": 21.761, "anchored_on_pause": false}, {"i": 12, "text": "No começo,", "start": 21.761, "end": 22.257, "anchored_on_pause": false}, {"i": 13, "text": "Marina achou que fosse algum defeito elétrico.", "start": 22.257, "end": 24.363, "anchored_on_pause": true}, {"i": 14, "text": "Mas aquilo acontecia todos os dias.", "start": 24.363, "end": 26.45, "anchored_on_pause": true}, {"i": 15, "text": "Três clarões,", "start": 26.45, "end": 27.041, "anchored_on_pause": true}, {"i": 16, "text": "sempre no mesmo horário.", "start": 27.041, "end": 28.466, "anchored_on_pause": true}, {"i": 17, "text": "Curiosa,", "start": 28.466, "end": 29.0, "anchored_on_pause": true}, {"i": 18, "text": "começou a observar.", "start": 29.0, "end": 30.228, "anchored_on_pause": true}, {"i": 19, "text": "Às nove em ponto,", "start": 30.228, "end": 31.158, "anchored_on_pause": true}, {"i": 20, "text": "a sala iluminava,", "start": 31.158, "end": 32.425, "anchored_on_pause": false}, {"i": 21, "text": "escurecia,", "start": 32.425, "end": 33.058, "anchored_on_pause": false}, {"i": 22, "text": "iluminava,", "start": 33.058, "end": 34.15, "anchored_on_pause": false}, {"i": 23, "text": "escurecia,", "start": 34.15, "end": 34.68, "anchored_on_pause": false}, {"i": 24, "text": "iluminava mais uma vez e então permanecia apagada.", "start": 34.68, "end": 37.535, "anchored_on_pause": true}, {"i": 25, "text": "Um dia,", "start": 37.535, "end": 37.848, "anchored_on_pause": false}, {"i": 26, "text": "encontrou o porteiro e perguntou se ele sabia quem morava ali.", "start": 37.848, "end": 41.028, "anchored_on_pause": true}, {"i": 27, "text": "O homem respondeu apenas que era seu Augusto,", "start": 41.028, "end": 42.963, "anchored_on_pause": true}, {"i": 28, "text": "um senhor educado que preferia ficar quieto.", "start": 42.963, "end": 44.88, "anchored_on_pause": false}, {"i": 29, "text": "Marina perguntou por que ele nunca aparecia.", "start": 44.88, "end": 47.0, "anchored_on_pause": true}, {"i": 30, "text": "O porteiro sorriu e disse que talvez ela devesse perguntar diretamente.", "start": 47.0, "end": 50.488, "anchored_on_pause": true}, {"i": 31, "text": "Às oito e cinquenta e cinco,", "start": 50.488, "end": 51.401, "anchored_on_pause": true}, {"i": 32, "text": "Marina ficou diante da porta do 302.", "start": 51.401, "end": 53.947, "anchored_on_pause": true}, {"i": 33, "text": "Esperou.", "start": 53.947, "end": 54.423, "anchored_on_pause": true}, {"i": 34, "text": "Às nove,", "start": 54.423, "end": 54.923, "anchored_on_pause": false}, {"i": 35, "text": "viu a luz piscar três vezes por baixo da porta.", "start": 54.923, "end": 57.201, "anchored_on_pause": true}, {"i": 36, "text": "Criou coragem e bateu.", "start": 57.201, "end": 58.557, "anchored_on_pause": true}, {"i": 37, "text": "Demorou alguns segundos até ouvir passos lentos.", "start": 58.557, "end": 60.851, "anchored_on_pause": true}, {"i": 38, "text": "A porta se abriu só um pouquinho,", "start": 60.851, "end": 62.845, "anchored_on_pause": true}, {"i": 39, "text": "revelando um senhor de cabelos brancos,", "start": 62.845, "end": 64.68, "anchored_on_pause": true}, {"i": 40, "text": "sentado numa cadeira de rodas.", "start": 64.68, "end": 66.15, "anchored_on_pause": true}, {"i": 41, "text": "Ele pareceu surpreso ao vê-la.", "start": 66.15, "end": 67.729, "anchored_on_pause": true}, {"i": 42, "text": "Marina pediu desculpas pela intromissão e perguntou sobre as luzes.", "start": 67.729, "end": 70.845, "anchored_on_pause": true}, {"i": 43, "text": "Augusto olhou para a sala e sorriu.", "start": 70.845, "end": 73.011, "anchored_on_pause": true}, {"i": 44, "text": "Explicou que,", "start": 73.011, "end": 73.354, "anchored_on_pause": false}, {"i": 45, "text": "há muitos anos,", "start": 73.354, "end": 74.077, "anchored_on_pause": true}, {"i": 46, "text": "sua esposa trabalhava no turno da manhã e passava pela rua às nove,", "start": 74.077, "end": 78.087, "anchored_on_pause": true}, {"i": 47, "text": "voltando do mercado.", "start": 78.087, "end": 78.685, "anchored_on_pause": true}, {"i": 48, "text": "Antes de adoecer,", "start": 78.685, "end": 79.708, "anchored_on_pause": true}, {"i": 49, "text": "ela costumava acenar da calçada quando via a luz da sala piscar.", "start": 79.708, "end": 83.15, "anchored_on_pause": false}, {"i": 50, "text": "Era o sinal dos dois:", "start": 83.15, "end": 84.225, "anchored_on_pause": false}, {"i": 51, "text": "três vezes significava \"estou aqui\".", "start": 84.225, "end": 85.982, "anchored_on_pause": true}, {"i": 52, "text": "A esposa já havia falecido,", "start": 85.982, "end": 87.543, "anchored_on_pause": true}, {"i": 53, "text": "mas Augusto continuava repetindo o pequeno ritual.", "start": 87.543, "end": 90.15, "anchored_on_pause": true}, {"i": 54, "text": "Não porque acreditasse que ela fosse voltar,", "start": 90.15, "end": 92.321, "anchored_on_pause": true}, {"i": 55, "text": "explicou,", "start": 92.321, "end": 92.729, "anchored_on_pause": false}, {"i": 56, "text": "mas porque aquele gesto o ajudava a começar o dia lembrando de uma vida feliz.", "start": 92.729, "end": 96.801, "anchored_on_pause": false}, {"i": 57, "text": "Marina ficou sem palavras.", "start": 96.801, "end": 98.093, "anchored_on_pause": true}, {"i": 58, "text": "O mistério que parecia estranho era,", "start": 98.093, "end": 99.846, "anchored_on_pause": false}, {"i": 59, "text": "na verdade,", "start": 99.846, "end": 100.295, "anchored_on_pause": false}, {"i": 60, "text": "uma lembrança guardada com carinho.", "start": 100.295, "end": 102.086, "anchored_on_pause": true}, {"i": 61, "text": "Antes de ir embora,", "start": 102.086, "end": 103.036, "anchored_on_pause": true}, {"i": 62, "text": "perguntou se ele gostaria de companhia para tomar um café algum dia.", "start": 103.036, "end": 106.677, "anchored_on_pause": true}, {"i": 63, "text": "Augusto sorriu e abriu um pouco mais a porta.", "start": 106.677, "end": 109.081, "anchored_on_pause": true}, {"i": 64, "text": "Naquela manhã,", "start": 109.081, "end": 109.896, "anchored_on_pause": false}, {"i": 65, "text": "pela primeira vez em muito tempo,", "start": 109.896, "end": 111.809, "anchored_on_pause": true}, {"i": 66, "text": "a luz do 302 não foi a única coisa que se acendeu:", "start": 111.809, "end": 115.564, "anchored_on_pause": true}, {"i": 67, "text": "alguém também bateu à porta.", "start": 115.564, "end": 116.756, "anchored_on_pause": true}, {"i": 68, "text": "E você?", "start": 116.756, "end": 117.232, "anchored_on_pause": true}, {"i": 69, "text": "Se percebesse um vizinho repetindo um gesto misterioso todos os dias,", "start": 117.232, "end": 121.259, "anchored_on_pause": true}, {"i": 70, "text": "teria coragem de bater na porta para descobrir o motivo?", "start": 121.259, "end": 124.108, "anchored_on_pause": null}], "words": [{"w": "O", "start": 0.0, "end": 0.05, "seg": 0}, {"w": "vizinho", "start": 0.095, "end": 0.232, "seg": 0}, {"w": "que", "start": 0.232, "end": 0.432, "seg": 0}, {"w": "nunca", "start": 0.432, "end": 0.832, "seg": 0}, {"w": "sai", "start": 0.832, "end": 1.032, "seg": 0}, {"w": "de", "start": 1.032, "end": 1.232, "seg": 0}, {"w": "casa.", "start": 1.232, "end": 1.632, "seg": 0}, {"w": "Você", "start": 1.632, "end": 2.032, "seg": 1}, {"w": "já", "start": 2.032, "end": 2.17, "seg": 1}, {"w": "teve", "start": 2.17, "end": 2.444, "seg": 1}, {"w": "um", "start": 2.444, "end": 2.582, "seg": 1}, {"w": "vizinho", "start": 2.582, "end": 2.994, "seg": 1}, {"w": "que", "start": 2.994, "end": 3.131, "seg": 1}, {"w": "parecia", "start": 3.131, "end": 3.543, "seg": 1}, {"w": "existir", "start": 3.543, "end": 3.955, "seg": 1}, {"w": "apenas", "start": 3.955, "end": 4.221, "seg": 1}, {"w": "atrás", "start": 4.221, "end": 4.493, "seg": 1}, {"w": "de", "start": 4.493, "end": 4.629, "seg": 1}, {"w": "uma", "start": 4.629, "end": 4.9, "seg": 1}, {"w": "porta?", "start": 4.9, "end": 5.2, "seg": 1}, {"w": "No", "start": 5.2, "end": 5.35, "seg": 2}, {"w": "prédio", "start": 5.35, "end": 5.65, "seg": 2}, {"w": "onde", "start": 5.65, "end": 6.15, "seg": 2}, {"w": "Marina", "start": 6.15, "end": 6.599, "seg": 2}, {"w": "morava,", "start": 6.599, "end": 7.016, "seg": 2}, {"w": "havia", "start": 7.016, "end": 7.294, "seg": 3}, {"w": "um", "start": 7.294, "end": 7.433, "seg": 3}, {"w": "homem", "start": 7.433, "end": 7