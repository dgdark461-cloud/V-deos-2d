 ],
 "segments": [
  {
   "i": 0,
   "text": "O vizinho que nunca sai de casa.",
   "start": 0.0,
   "end": 1.65,
   "anchored_on_pause": true
  },
  {
   "i": 1,
   "text": "Você já teve um vizinho que parecia existir apenas atrás de uma porta?",
   "start": 1.8,
   "end": 5.13,
   "anchored_on_pause": true
  },
  {
   "i": 2,
   "text": "No prédio onde Marina morava,",
   "start": 5.27,
   "end": 6.73,
   "anchored_on_pause": true
  },
  {
   "i": 3,
   "text": "havia um homem no apartamento 302 que ninguém via.",
   "start": 7.12,
   "end": 10.1,
   "anchored_on_pause": true
  },
  {
   "i": 4,
   "text": "Nunca recebia visitas,",
   "start": 10.25,
   "end": 11.52,
   "anchored_on_pause": false
  },
  {
   "i": 5,
   "text": "nunca descia para buscar encomendas e,",
   "start": 11.52,
   "end": 13.32,
   "anchored_on_pause": true
  },
  {
   "i": 6,
   "text": "segundo o porteiro,",
   "start": 13.66,
   "end": 14.742,
   "anchored_on_pause": false
  },
  {
   "i": 7,
   "text": "quase nunca saía.",
   "start": 14.742,
   "end": 15.71,
   "anchored_on_pause": true
  },
  {
   "i": 8,
   "text": "Mesmo assim,",
   "start": 15.83,
   "end": 16.35,
   "anchored_on_pause": true
  },
  {
   "i": 9,
   "text": "todas as manhãs,",
   "start": 16.5,
   "end": 17.38,
   "anchored_on_pause": false
  },
  {
   "i": 10,
   "text": "exatamente às nove horas,",
   "start": 17.38,
   "end": 18.83,
   "anchored_on_pause": true
  },
  {
   "i": 11,
   "text": "a luz da sala dele acendia e apagava três vezes.",
   "start": 19.12,
   "end": 21.471,
   "anchored_on_pause": false
  },
  {
   "i": 12,
   "text": "No começo,",
   "start": 21.471,
   "end": 22.051,
   "anchored_on_pause": false
  },
  {
   "i": 13,
   "text": "Marina achou que fosse algum defeito elétrico.",
   "start": 22.051,
   "end": 24.24,
   "anchored_on_pause": true
  },
  {
   "i": 14,
   "text": "Mas aquilo acontecia todos os dias.",
   "start": 24.42,
   "end": 26.19,
   "anchored_on_pause": true
  },
  {
   "i": 15,
   "text": "Três clarões,",
   "start": 26.36,
   "end": 27.13,
   "anchored_on_pause": true
  },
  {
   "i": 16,
   "text": "sempre no mesmo horário.",
   "start": 27.28,
   "end": 28.49,
   "anchored_on_pause": true
  },
  {
   "i": 17,
   "text": "Curiosa,",
   "start": 28.72,
   "end": 29.18,
   "anchored_on_pause": true
  },
  {
   "i": 18,
   "text": "começou a observar.",
   "start": 29.33,
   "end": 30.03,
   "anchored_on_pause": true
  },
  {
   "i": 19,
   "text": "Às nove em ponto,",
   "start": 30.19,
   "end": 31.42,
   "anchored_on_pause": true
  },
  {
   "i": 20,
   "text": "a sala iluminava,",
   "start": 31.58,
   "end": 32.8,
   "anchored_on_pause": false
  },
  {
   "i": 21,
   "text": "escurecia,",
   "start": 32.8,
   "end": 33.38,
   "anchored_on_pause": false
  },
  {
   "i": 22,
   "text": "iluminava,",
   "start": 33.38,
   "end": 34.086,
   "anchored_on_pause": false
  },
  {
   "i": 23,
   "text": "escurecia,",
   "start": 34.086,
   "end": 34.666,
   "anchored_on_pause": false
  },
  {
   "i": 24,
   "text": "iluminava mais uma vez e então permanecia apagada.",
   "start": 34.666,
   "end": 37.6,
   "anchored_on_pause": true
  },
  {
   "i": 25,
   "text": "Um dia,",
   "start": 37.84,
   "end": 38.107,
   "anchored_on_pause": false
  },
  {
   "i": 26,
   "text": "encontrou o porteiro e perguntou se ele sabia quem morava ali.",
   "start": 38.107,
   "end": 40.86,
   "anchored_on_pause": true
  },
  {
   "i": 27,
   "text": "O homem respondeu apenas que era seu Augusto,",
   "start": 40.98,
   "end": 43.01,
   "anchored_on_pause": true
  },
  {
   "i": 28,
   "text": "um senhor educado que preferia ficar quieto.",
   "start": 43.23,
   "end": 44.855,
   "anchored_on_pause": false
  },
  {
   "i": 29,
   "text": "Marina perguntou por que ele nunca aparecia.",
   "start": 44.855,
   "end": 46.86,
   "anchored_on_pause": true
  },
  {
   "i": 30,
   "text": "O porteiro sorriu e disse que talvez ela devesse perguntar diretamente.",
   "start": 47.02,
   "end": 50.13,
   "anchored_on_pause": true
  },
  {
   "i": 31,
   "text": "Às oito e cinquenta e cinco,",
   "start": 50.35,
   "end": 51.4,
   "anchored_on_pause": true
  },
  {
   "i": 32,
   "text": "Marina ficou diante da porta do 302.",
   "start": 51.57,
   "end": 53.8,
   "anchored_on_pause": true
  },
  {
   "i": 33,
   "text": "Esperou.",
   "start": 53.96,
   "end": 54.33,
   "anchored_on_pause": true
  },
  {
   "i": 34,
   "text": "Às nove,",
   "start": 54.52,
   "end": 55.162,
   "anchored_on_pause": false
  },
  {
   "i": 35,
   "text": "viu a luz piscar três vezes por baixo da porta.",
   "start": 55.162,
   "end": 57.4,
   "anchored_on_pause": true
  },
  {
   "i": 36,
   "text": "Criou coragem e bateu.",
   "start": 57.59,
   "end": 58.68,
   "anchored_on_pause": true
  },
  {
   "i": 37,
   "text": "Demorou alguns segundos até ouvir passos lentos.",
   "start": 58.93,
   "end": 61.01,
   "anchored_on_pause": true
  },
  {
   "i": 38,
   "text": "A porta se abriu só um pouquinho,",
   "start": 61.32,
   "end": 62.78,
   "anchored_on_pause": true
  },
  {
   "i": 39,
   "text": "revelando um senhor de cabelos brancos,",
   "start": 62.91,
   "end": 64.66,
   "anchored_on_pause": true
  },
  {
   "i": 40,
   "text": "sentado numa cadeira de rodas.",
   "start": 64.79,
   "end": 66.12,
   "anchored_on_pause": true
  },
  {
   "i": 41,
   "text": "Ele pareceu surpreso ao vê-la.",
   "start": 66.25,
   "end": 67.54,
   "anchored_on_pause": true
  },
  {
   "i": 42,
   "text": "Marina pediu desculpas pela intromissão e perguntou sobre as luzes.",
   "start": 67.93,
   "end": 70.82,
   "anchored_on_pause": true
  },
  {
   "i": 43,
   "text": "Augusto olhou para a sala e sorriu.",
   "start": 71.03,
   "end": 72.54,
   "anchored_on_pause": true
  },
  {
   "i": 44,
   "text": "Explicou que,",
   "start": 72.85,
   "end": 73.497,
   "anchored_on_pause": false
  },
  {
   "i": 45,
   "text": "há muitos anos,",
   "start": 73.497,
   "end": 74.25,
   "anchored_on_pause": true
  },
  {
   "i": 46,
   "text": "sua esposa trabalhava no turno da manhã e passava pela rua às nove,",
   "start": 74.39,
   "end": 77.58,
   "anchored_on_pause": true
  },
  {
   "i": 47,
   "text": "voltando do mercado.",
   "start": 77.75,
   "end": 78.59,
   "anchored_on_pause": true
  },
  {
   "i": 48,
   "text": "Antes de adoecer,",
   "start": 78.86,
   "end": 79.69,
   "anchored_on_pause": true
  },
  {
   "i": 49,
   "text": "ela costumava acenar da calçada quando via a luz da sala piscar.",
   "start": 79.82,
   "end": 82.665,
   "anchored_on_pause": false
  },
  {
   "i": 50,
   "text": "Era o sinal dos dois:",
   "start": 82.665,
   "end": 83.873,
   "anchored_on_pause": false
  },
  {
   "i": 51,
   "text": "três vezes significava \"estou aqui\".",
   "start": 83.873,
   "end": 86.02,
   "anchored_on_pause": true
  },
  {
   "i": 52,
   "text": "A esposa já havia falecido,",
   "start": 86.14,
   "end": 87.66,
   "anchored_on_pause": true
  },
  {
   "i": 53,
   "text": "mas Augusto continuava repetindo o pequeno ritual.",
   "start": 87.85,
   "end": 90.07,
   "anchored_on_pause": true
  },
  {
   "i": 54,
   "text": "Não porque acreditasse que ela fosse voltar,",
   "start": 90.19,
   "end": 92.18,
   "anchored_on_pause": true
  },
  {
   "i": 55,
   "text": "explicou,",
   "start": 92.33,
   "end": 92.586,
   "anchored_on_pause": false
  },
  {
   "i": 56,
   "text": "mas porque aquele gesto o ajudava a começar o dia lembrando de uma vida feliz.",
   "start": 92.586,
   "end": 96.647,
   "anchored_on_pause": false
  },
  {
   "i": 57,
   "text": "Marina ficou sem palavras.",
   "start": 96.647,
   "end": 97.69,
   "anchored_on_pause": true
  },
  {
   "i": 58,
   "text": "O mistério que parecia estranho era,",
   "start": 97.82,
   "end": 99.702,
   "anchored_on_pause": false
  },
  {
   "i": 59,
   "text": "na verdade,",
   "start": 99.702,
   "end": 100.532,
   "anchored_on_pause": false
  },
  {
   "i": 60,
   "text": "uma lembrança guardada com carinho.",
   "start": 100.532,
   "end": 102.02,
   "anchored_on_pause": true
  },
  {
   "i": 61,
   "text": "Antes de ir embora,",
   "start": 102.27,
   "end": 103.1,
   "anchored_on_pause": true
  },
  {
   "i": 62,
   "text": "perguntou se ele gostaria de companhia para tomar um café algum dia.",
   "start": 103.51,
   "end": 106.37,
   "anchored_on_pause": true
  },
  {
   "i": 63,
   "text": "Augusto sorriu e abriu um pouco mais a porta.",
   "start": 106.51,
   "end": 108.83,
   "anchored_on_pause": true
  },
  {
   "i": 64,
   "text": "Naquela manhã,",
   "start": 109.11,
   "end": 109.916,
   "anchored_on_pause": false
  },
  {
   "i": 65,
   "text": "pela primeira vez em muito tempo,",
   "start": 109.916,
   "end": 111.44,
   "anchored_on_pause": true
  },
  {
   "i": 66,
   "text": "a luz do 302 não foi a única coisa que se acendeu:",
   "start": 111.89,
   "end": 114.92,
   "anchored_on_pause": true
  },
  {
   "i": 67,
   "text": "alguém também bateu à porta.",
   "start": 115.08,
   "end": 116.53,
   "anchored_on_pause": true
  },
  {
   "i": 68,
   "text": "E você?",
   "start": 116.79,
   "end": 117.28,
   "anchored_on_pause": true
  },
  {
   "i": 69,
   "text": "Se percebesse um vizinho repetindo um gesto misterioso todos os dias,",
   "start": 117.73,
   "end": 121.45,
   "anchored_on_pause": true
  },
  {
   "i": 70,
   "text": "teria coragem de bater na porta para descobrir o motivo?",
   "start": 121.84,
   "end": 124.06,
   "anchored_on_pause": null
  }
 ],
